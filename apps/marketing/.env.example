# Marketing site auth + billing env.
#
# Local dev: copy to `.env` and fill. Values with the PUBLIC_ prefix
# are embedded in the static bundle; others are server-only.
#
# Production: set these in Cloudflare Pages → Settings → Environment
# variables. Use the "Production" scope for prod, "Preview" for
# preview branches (with a separate Stripe test key + Supabase
# staging project so bad preview code can't touch prod data).

# ── Supabase ─────────────────────────────────────────────────────
# Project URL — https://<project-ref>.supabase.co
PUBLIC_SUPABASE_URL=
# Anon (public) key — safe to embed in the browser bundle.
PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER-ONLY. Bypasses RLS. Used by the Stripe
# webhook to write license rows on behalf of the user. NEVER put a
# PUBLIC_ prefix on this variable.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen --forward-to localhost:4321/api/stripe-webhook`
# (dev) or Stripe Dashboard → Webhooks (prod).
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs for the products you created in Stripe. See docs/AUTH-SETUP.md.
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_...
