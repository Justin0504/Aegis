      .replay mark { background: #f3e1c6; color: #6b430c; }
      .replay .prov .bars i::after { width: calc(var(--v) * 100%); }
      .replay [data-out] { display: none !important; }
      .replay .rv-btn.allow { background: #2d5a4a; color: #fff; }
      .replay .rv-wait { display: none !important; }
      .replay .rv-done { display: flex !important; }
      .replay .rp-card:has(.stamp.no) { border-color: #e6b8b0 !important; background: #fffaf9 !important; }
      .replay .rp-card:has(.stamp.ok) { border-color: #bcd3c6 !important; background: #f7fbf8 !important; box-shadow: 0 30px 70px #2d5a4a22 !important; }
