    .msg.call .fn { color: #a8c6b6; }
    .msg.call .s { color: #f0d2a4; }
    .msg.refusal { background: #f7e3df; border-color: #ecc8c1; color: #6e231b; }
    .msg.refusal code { font-size: 0.86em; color: #6e231b; background: #ffffff80; }
    .ch.no { background: #a3362d; color: #fff; }

    .rp-gate { position: relative; padding-left: clamp(1.4rem, 0.8rem + 2vw, 3rem); }
    .gate-line { position: absolute; left: 0; top: -1rem; bottom: -1rem; width: 2px; background: var(--line); border-radius: 2px; overflow: hidden; }
    .gate-line i { position: absolute; left: 0; right: 0; top: 0; height: calc(var(--rp, 0) * 100%); background: linear-gradient(#577b6d, #152b2d); }
    .rp-card {
      position: relative; border-radius: 18px; padding: 1rem 1.15rem 1.05rem; background: #fff; border: 1px solid #e3dfd6;
      box-shadow: 0 2px 4px #152b2d0f, 0 30px 70px #152b2d26; margin-bottom: 1.1rem; overflow: hidden;
      transition: border-color 0.4s ease, box-shadow 0.4s ease, background-color 0.4s ease;
    }
    .rc-top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 0.55rem; }
