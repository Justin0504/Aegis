    }

    /* ── Tour (held, paged by scroll) ─────────────────────────────── */
    .tour { position: relative; height: calc(var(--n) * 80svh + 100svh); }
    .tour-stage {
      position: sticky;
      top: 0;
      height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: clamp(1rem, 0.5rem + 1.5vh, 2rem);
      padding: 5.2rem clamp(1rem, 0.4rem + 2.4vw, 3rem) 1.4rem;
    }
    .tour-head { display: flex; align-items: baseline; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
    .tour-head .eyebrow-line { margin: 0; }
    .tour-h { font-size: clamp(1.7rem, 1.1rem + 1.9vw, 3.1rem); line-height: 1.02; margin: 0; color: var(--ink-strong); flex: 1; text-align: right; }
    .tour-body {
      display: grid;
      grid-template-columns: minmax(15rem, 22rem) minmax(0, 1fr);
      gap: clamp(1.2rem, 0.5rem + 2.4vw, 3.4rem);
      align-items: center;
      min-height: 0;
    }
    .tour-nav { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.15rem; }
    .tn { position: relative; padding: 0.55rem 0 0.6rem; border-top: 1px solid var(--line); }
    .tn button {
      all: unset; cursor: pointer; display: flex; gap: 0.8rem; align-items: baseline; width: 100%;
      color: var(--muted); transition: color 0.3s ease;
    }
    .tn button:focus-visible { outline: 2px solid var(--sage); outline-offset: 4px; border-radius: 4px; }
    .tn-i { font-family: var(--font-mono); font-size: 0.72rem; color: var(--sage-text); margin: 0; }
    .tn-t { font-size: 1.02rem; line-height: 1.25; }
    .tn-d {
      margin: 0; padding-left: 1.85rem; color: var(--muted); font-size: 0.86rem; line-height: 1.45;
      max-height: 0; opacity: 0; overflow: hidden; transition: max-height 0.45s ease, opacity 0.35s ease, margin 0.35s ease;
    }
    .tn.on button { color: var(--ink-strong); }
    .tn.on .tn-d { max-height: 8rem; opacity: 1; margin-top: 0.45rem; }
    .tn-bar { position: absolute; left: 0; right: 0; top: -1px; height: 1px; overflow: hidden; }
    .tn-bar b { display: block; height: 100%; width: 100%; background: var(--ink); transform-origin: 0 50%; transform: scaleX(0); }
    .tour-frame {
      margin: 0;
      border-radius: 18px;
      background: #fff;
      border: 1px solid #e3dfd6;
      box-shadow: 0 2px 4px #152b2d0f, 0 40px 90px #152b2d2a;
      overflow: hidden;
      transform-origin: 50% 40%;
      will-change: transform;
      /* Never taller than the stage allows, keeping 16:10 inside. */
      width: min(100%, calc((100svh - 15rem) * 1.6));
      justify-self: end;
    }
    .tf-bar { display: flex; align-items: center; gap: 0.4rem; padding: 0.6rem 0.9rem; border-bottom: 1px solid #ece8e0; background: #faf9f6; }
    .tf-bar i { width: 10px; height: 10px; border-radius: 50%; background: #dcd8cf; }
    .tf-url { margin-left: 0.8rem; font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); background: #fff; border: 1px solid #ece8e0; border-radius: 999px; padding: 0.15rem 0.8rem; }
    .tf-url b { font-weight: 400; color: var(--ink); }
    .tf-view { position: relative; aspect-ratio: 16 / 10; background: #fff; }
    .tf-shot { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: left top; opacity: 0; will-change: opacity, transform; }
    .tf-shot:first-child { opacity: 1; }
    .tour-cta { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; }
    .tour-stack { display: none; }
    @media (max-width: 1080px), (max-height: 640px), (prefers-reduced-motion: reduce) {
      .tour { height: auto; padding: 8vh 0 0; }
      .tour-stage { position: static; height: auto; padding: 0 1.25rem; }
      .tour-body { display: none; }
      .tour-h { text-align: left; }
      .tour-cta { order: 3; }
      .tour-stack { display: grid; gap: 3.2rem; padding: 2.4rem 1.25rem 2.4rem; max-width: 64rem; margin: 0 auto; }
      .ts h3 { font-family: var(--font-display); font-weight: 400; font-size: 1.6rem; margin: 0.2rem 0 0.4rem; color: var(--ink-strong); }
      .ts p { margin: 0; color: var(--muted); line-height: 1.5; }
      .ts img { display: block; width: 100%; height: auto; margin-top: 1.1rem; border-radius: 12px; border: 1px solid #e3dfd6; box-shadow: 0 24px 50px #152b2d1f; }
    }
    @media (prefers-color-scheme: dark) { .tour-h { color: var(--ink); } }

    /* ── Use cases ────────────────────────────────────────────────── */
    .cases { padding: 16vh clamp(1rem, 0.4rem + 2.4vw, 3rem) 6vh; max-width: 92rem; margin: 0 auto; }
    .cases-head { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem 3rem; align-items: end; margin-bottom: clamp(2.4rem, 1.6rem + 3vw, 4.5rem); }
    .cases-head .eyebrow-line { grid-column: 1 / -1; margin: 0; }
    .cases-head h2 { font-size: clamp(2rem, 1.2rem + 3vw, 4.4rem); line-height: 1; margin: 0; color: var(--ink-strong); }
    .cases-sub { margin: 0; color: var(--muted); line-height: 1.5; max-width: 34rem; justify-self: end; }
    .cases-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(0.8rem, 0.4rem + 1vw, 1.4rem); }
    .case {
      display: flex; flex-direction: column;
      border-radius: 22px; overflow: hidden;
      background: var(--paper-raised);
      border: 1px solid var(--line);
      transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.4s ease;
    }
    .case:hover { transform: translateY(-4px); box-shadow: 0 30px 60px #152b2d1a; }
    .case-img {
      aspect-ratio: 16 / 9;
      display: grid; place-items: center;
      padding: clamp(1rem, 0.6rem + 1.2vw, 1.8rem);
      background: linear-gradient(160deg, #e7ece6, #d6e0d9 60%, #cfd9d2);
    }
    .case-img img { width: 100%; height: auto; max-height: 100%; object-fit: contain; border-radius: 10px; box-shadow: 0 1px 2px #152b2d1a, 0 18px 40px #152b2d26; }
    .case-txt { padding: 1.3rem 1.4rem 1.6rem; }
    .case-k { display: flex; justify-content: space-between; align-items: center; gap: 0.6rem; margin: 0 0 0.7rem; font-size: 0.76rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--sage-text); }
    .verdict { font-family: var(--font-mono); text-transform: none; letter-spacing: 0; font-size: 0.72rem; padding: 0.15rem 0.6rem; border-radius: 999px; }
    .verdict.block { background: #f4dcd8; color: #8a2b22; }
    .verdict.hold { background: #f3e5cc; color: #7a4d0e; }
    .case h3 { font-family: var(--font-display); font-weight: 400; font-size: 1.45rem; line-height: 1.12; margin: 0 0 0.6rem; color: var(--ink-strong); }
    .case p { margin: 0; color: var(--muted); font-size: 0.94rem; line-height: 1.5; }
    @media (prefers-color-scheme: dark) { .cases-head h2, .case h3 { color: var(--ink); } }
    @media (max-width: 1000px) { .cases-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 680px) {
      .cases-head { grid-template-columns: 1fr; }
      .cases-sub { justify-self: start; }
      .cases-grid { grid-template-columns: 1fr; }
    }

    /* ── Split (held features) ────────────────────────────────────── */
    .split { position: relative; height: calc(var(--steps) * 100svh); margin-top: 10vh; }
    .split-stage {
      position: sticky;
      top: 0;
      height: 100svh;
      display: grid;
      grid-template-columns: 1.15fr 1fr;
    }
    .split-media {
      position: relative;
      margin: 5.5rem 0 1.5rem;
      overflow: hidden;
      border-radius: 0 var(--radius-panel) var(--radius-panel) 0;
      will-change: clip-path;
      -webkit-mask-image: linear-gradient(90deg, #000 0, #000 94%, transparent 100%);
              mask-image: linear-gradient(90deg, #000 0, #000 94%, transparent 100%);
    }
    .sm-layer {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      padding: clamp(1.2rem, 0.6rem + 2.4vw, 3.6rem);
      background-size: cover;
      background-position: center;
      opacity: 0;
      will-change: opacity, transform, filter;
    }
    .sm-layer:nth-child(2) { opacity: 1; }
    .split-media { background: radial-gradient(120% 90% at 30% 40%, #1d3a3a 0%, #132628 55%, #0e1d1f 100%); }
    .trace-tex {
      position: absolute;
      inset: -2rem 0 0 -1rem;
      margin: 0;
      font-family: var(--font-mono);
      font-size: 0.78rem;
      line-height: 2.1;
      letter-spacing: 0.04em;
      color: #9fb4a7;
      opacity: 0.16;
      white-space: pre;
      overflow: hidden;
      -webkit-mask-image: linear-gradient(180deg, transparent, #000 18%, #000 82%, transparent);
              mask-image: linear-gradient(180deg, transparent, #000 18%, #000 82%, transparent);
      pointer-events: none;
    }
    .split-text { position: relative; }
    .st-step {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
