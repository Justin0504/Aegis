    :global(html:not(.motion)) .replay .stamp { opacity: 0.92; transform: translateY(-50%) rotate(-9deg); }
    :global(html:not(.motion)) .replay .prov .bars i::after { width: calc(var(--v) * 100%); }
    :global(html:not(.motion)) .replay [data-out] { display: none; }
    :global(html:not(.motion)) .replay .rv-btn.allow { background: #2d5a4a; color: #fff; }
    :global(html:not(.motion)) .replay .rv-wait { display: none; }
    :global(html:not(.motion)) .replay .rv-done { display: flex; }
    :global(html:not(.motion)) .replay .rp-card:has(.stamp.no) { border-color: #e6b8b0; background: #fffaf9; }
    :global(html:not(.motion)) .replay .rp-card:has(.stamp.ok) { border-color: #bcd3c6; background: #f7fbf8; }
    @media (prefers-color-scheme: dark) { .rp-h { color: var(--ink); } }
    @media (max-width: 960px), (max-height: 640px), (prefers-reduced-motion: reduce) {
