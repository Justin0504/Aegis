    .rp-idle {
      position: absolute; left: clamp(1.4rem, 0.8rem + 2vw, 3rem); right: 0; top: 0;
      display: flex; align-items: center; gap: 0.6rem; padding: 1.2rem 1.15rem;
      border: 1px dashed var(--line); border-radius: 18px; color: var(--muted);
      font-family: var(--font-mono); font-size: 0.8rem; transition: opacity 0.4s ease;
