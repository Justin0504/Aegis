    .stamp {
      position: absolute; right: 1.1rem; top: 58%;
      font-family: var(--font-mono); font-size: clamp(1.1rem, 0.8rem + 1vw, 1.7rem); letter-spacing: 0.14em; text-transform: uppercase;
      color: #a3362d; border: 3px solid #a3362d; border-radius: 10px; padding: 0.2rem 0.75rem;
      opacity: 0; transform: translateY(-50%) rotate(-9deg) scale(1.9);
      transition: opacity 0.18s ease, transform 0.42s cubic-bezier(0.2, 1.5, 0.35, 1);
      mix-blend-mode: multiply;
    }
    .stamp.in { opacity: 0.92; transform: translateY(-50%) rotate(-9deg) scale(1); }
