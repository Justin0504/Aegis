    .rp-h { font-size: clamp(2rem, 1.2rem + 2.8vw, 4.4rem); line-height: 1; margin: 0; color: var(--ink-strong); }
    .rp-body { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(1.2rem, 0.5rem + 3vw, 4.5rem); align-items: center; }
    .rp-note { margin: 0; font-size: 0.78rem; color: var(--muted); }
    .rp-label { font-family: var(--font-mono); font-size: 0.72rem; color: var(--sage-text); margin: 0 0 0.8rem; letter-spacing: 0.03em; }

    .rp-chat { display: grid; gap: 0.6rem; }
    .msg {
      border-radius: 16px; padding: 0.8rem 1rem; font-size: clamp(0.88rem, 0.82rem + 0.2vw, 0.98rem); line-height: 1.45;
