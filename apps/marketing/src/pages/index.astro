    .stamp.ok { color: #2d5a4a; border-color: #2d5a4a; }
    .rp-card:has(.stamp.in) { animation: rp-hit 0.42s ease 0.12s; }
    .rp-card:has(.stamp.no.in) { border-color: #e6b8b0; background: #fffaf9; box-shadow: 0 0 0 6px #a3362d14, 0 30px 70px #a3362d24; }
    .rp-card:has(.stamp.hold.in) { border-color: #ead3ad; background: #fffbf4; box-shadow: 0 0 0 6px #b07a1e14, 0 30px 70px #b07a1e22; }
    .rp-card:has(.stamp.ok.in) { border-color: #bcd3c6; background: #f7fbf8; box-shadow: 0 0 0 6px #2d5a4a14, 0 30px 70px #2d5a4a22; }
    .rc-globe { width: 16px; height: 16px; border-radius: 50%; border: 1.6px solid #3d6f8e; position: relative; }
    .rc-globe::after { content: ""; position: absolute; inset: 0 4px; border: 1.4px solid #3d6f8e; border-radius: 50%; }

    .msg.waiting { background: #fbf2e2; border-color: #ecd9b5; color: #6b430c; display: block; }
    .msg.approved { background: #e7f0ea; border-color: #c8dccf; color: #1f4436; }
    .msg.approved code { font-size: 0.86em; background: #ffffff90; color: #1f4436; }
    .ch.hold { background: #b07a1e; color: #fff; }
    .ch.ok { background: #2d5a4a; color: #fff; }
    .spinner { display: inline-block; width: 0.8em; height: 0.8em; margin-left: 0.4rem; vertical-align: -0.1em; border: 2px solid #b07a1e55; border-top-color: #b07a1e; border-radius: 50%; animation: rp-spin 0.9s linear infinite; }
    @keyframes rp-spin { to { transform: rotate(360deg); } }
    .review { margin-top: 0.9rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding: 0.75rem 0.9rem; border-radius: 14px; background: #fff; border: 1px solid #e3dfd6; box-shadow: 0 18px 40px #152b2d14; }
    .rv-k { margin: 0; display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; color: var(--ink); }
    .rv-actions { display: flex; gap: 0.45rem; }
    .rv-done { display: none; }
    .review:has(.rv-btn.allow.in) .rv-wait { display: none; }
    .review:has(.rv-btn.allow.in) .rv-done { display: flex; }
    /* the pending and the allowed result share one slot */
    .swap { display: grid; }
    .swap > .msg { grid-area: 1 / 1; }
    .rv-btn { font-size: 0.84rem; padding: 0.32rem 0.9rem; border-radius: 999px; border: 1px solid var(--line); color: var(--ink); background: var(--paper-raised); transition: background-color 0.3s ease, color 0.3s ease, transform 0.2s ease, box-shadow 0.3s ease; }
    .rv-btn.allow { border-color: #2d5a4a; color: #2d5a4a; }
    .rv-btn.allow.in { background: #2d5a4a; color: #fff; box-shadow: 0 0 0 5px #2d5a4a22; }
    @keyframes rp-hit {
      0%, 100% { translate: 0 0; }
      25% { translate: -5px 1px; }
      50% { translate: 4px -1px; }
      75% { translate: -2px 0; }
    }

    .checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
    .checks li {
      display: grid; grid-template-columns: 1.1rem auto 1fr; align-items: baseline; column-gap: 0.6rem;
      padding: 0.6rem 0.85rem; border-radius: 12px; background: var(--paper-raised); border: 1px solid var(--line);
      font-size: 0.92rem; color: var(--ink);
    }
    .checks em { font-style: normal; color: var(--muted); font-size: 0.84rem; justify-self: end; text-align: right; }
    .checks em code { font-size: 0.92em; }
    .ck { width: 0.7rem; height: 0.7rem; border-radius: 50%; align-self: center; }
    .ck.ok { background: #2d5a4a; }
    .ck.warn { background: #b07a1e; }
    .ck.no { background: #a3362d; }
    .checks .prov { grid-template-columns: 1.1rem auto; }
    .bars { grid-column: 1 / -1; display: grid; grid-template-columns: auto 1fr auto; gap: 0.35rem 0.7rem; align-items: center; margin-top: 0.55rem; font-size: 0.78rem; color: var(--muted); }
    .bars i { height: 7px; border-radius: 7px; background: var(--line); position: relative; overflow: hidden; }
    .bars i::after { content: ""; position: absolute; inset: 0; width: 0; background: var(--accent-positive); border-radius: 7px; transition: width 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s; }
    .bars i.u::after { background: #b07a1e; }
    .prov.in .bars i::after { width: calc(var(--v) * 100%); }
    .bars b { font-weight: 400; font-family: var(--font-mono); color: var(--ink); }
    .rp-foot { display: flex; align-items: center; gap: 0.5rem; margin: 1rem 0 0; font-size: 0.86rem; color: var(--sage-text); }

    /* Entering: rise and come into focus. Only when the script runs. */
    :global(html.motion) .replay [data-at]:not(mark):not(.stamp):not(.rv-btn) {
