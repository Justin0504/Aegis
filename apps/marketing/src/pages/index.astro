<script>
  // The copied string lives on the button, not in this script, so what a
  // reader sees and what lands on their clipboard cannot diverge.
  document.querySelectorAll('.install-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const cmd = btn.getAttribute('data-copy') || '';
      try {
        await navigator.clipboard.writeText(cmd);
      } catch {
        return; // clipboard blocked (http, permissions) — leave the label alone
      }
      const original = btn.textContent;
      btn.textContent = 'Copied';
      btn.setAttribute('data-copied', '');
      setTimeout(() => {
        btn.textContent = original;
        btn.removeAttribute('data-copied');
      }, 1600);
    });
  });
</script>
