---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import BlogCover from '@/components/BlogCover.astro';

// Generate one static page per blog entry at build time.
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props:  { post },
  }));
}

interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const { Content, headings } = await post.render();

// Table of contents — derived from the article's H2s. Astro's
// markdown pipeline auto-generates ids on headings, so anchor links
// work without extra rehype plugins. LLM crawlers use ToC nav to
// segment articles for citation.
const toc = headings.filter(h => h.depth === 2);

// ── Author info ─────────────────────────────────────────────────────
// Enriched Person schema per schema.org/Person guidance for GEO:
//   - `sameAs` fans out to social + academic profiles so LLM knowledge
//     graphs can dedupe the entity.
//   - `jobTitle` + `worksFor` establish institutional context.
//   - `knowsAbout` gives crawlers topical anchors for citation.
const AUTHORS = {
  justin: {
    name:  'Justin Yuan',
    title: 'Open-source maintainer, AEGIS · USC Viterbi',
    url:   'https://github.com/Justin0504',
    jobTitle:   'Graduate researcher',
    worksFor:   'University of Southern California',
    worksForUrl: 'https://viterbischool.usc.edu/',
    knowsAbout: [
      'AI agent runtime safety',
      'LLM judge calibration',
      'Prompt injection defense',
      'Cryptographic audit logs',
      'Merkle transparency logs',
    ],
    sameAs: [
      'https://github.com/Justin0504',
      'https://github.com/Justin0504/Aegis',
      'https://arxiv.org/a/yuan_a_1',
    ],
  },
  team: {
    name:  'AEGIS team',
    title: 'Engineering team',
    url:   'https://aegistraces.com',
    jobTitle:   'Engineering',
    worksFor:   'AEGIS',
    worksForUrl: 'https://aegistraces.com',
    knowsAbout: [
      'AI agent runtime safety',
      'Agent firewall',
      'Cryptographic audit',
    ],
    sameAs: [
      'https://github.com/Justin0504/Aegis',
    ],
  },
} as const;
const author = AUTHORS[post.data.author];

// ── JSON-LD structured data ─────────────────────────────────────────
// This is the single most important block for LLM crawlers. Google,
// Perplexity, ChatGPT all extract Article schema and use it to decide
// citation-worthiness. Keep every field accurate.
const url      = `https://aegistraces.com/blog/${post.slug}/`;
const datePub  = post.data.publishedAt.toISOString();
const dateMod  = (post.data.updatedAt ?? post.data.publishedAt).toISOString();
const wordCount = post.body.split(/\s+/).filter(Boolean).length;

// OG image — Unsplash hero (when set) or fall back to site default.
const ogImage = post.data.coverImage
  ? `https://images.unsplash.com/photo-${post.data.coverImage}?w=1200&h=630&q=80&fit=crop&auto=format`
  : 'https://aegistraces.com/aegis-og.png';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type':    'TechArticle',
  '@id':      url,
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  headline:    post.data.title,
  description: post.data.description,
  image:       ogImage,
  wordCount,
  datePublished: datePub,
  dateModified:  dateMod,
  inLanguage: 'en-US',
  author: {
    '@type':   'Person',
    name:      author.name,
    url:       author.url,
    jobTitle:  author.jobTitle,
    knowsAbout: author.knowsAbout,
    sameAs:    author.sameAs,
    worksFor: {
      '@type': 'Organization',
      name:    author.worksFor,
      url:     author.worksForUrl,
    },
  },
  publisher: {
    '@type': 'Organization',
    name:    'AEGIS',
    url:     'https://aegistraces.com',
    logo: {
      '@type': 'ImageObject',
      url:     'https://aegistraces.com/aegis-logo.png',
    },
  },
  // Specifically tells LLMs "this article answers this question"
  // — load-bearing for GEO. Schema.org `mainEntity.Question` would
  // be more semantic but Article-as-FAQ doesn't validate; stick with
  // `about` and `keywords` which DO validate.
  about: {
    '@type': 'Question',
    name:    post.data.answersQuery,
  },
  keywords: post.data.tags.join(', '),
  // SpeakableSpecification — voice-assistant + AI Overview extraction.
  // Points at the CSS selector wrapping the oneSentenceAnswer block so
  // Google Gemini / Alexa Skills / etc. know exactly what to read out.
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.speakable', '.takeaways'],
  },
};

// Separate FAQPage block — Google + Perplexity + ChatGPT all extract
// FAQPage independently of Article. Each key takeaway becomes a Q/A
// pair. The primary question is `answersQuery`; the primary answer is
// the article's description. Additional Q/A pairs are synthesised
// from `keyTakeaways` when present.
const faqJsonLd = post.data.keyTakeaways && post.data.keyTakeaways.length > 0 ? {
  '@context': 'https://schema.org',
  '@type':    'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name:    post.data.answersQuery,
      acceptedAnswer: {
        '@type': 'Answer',
        text:    post.data.description,
      },
    },
    ...post.data.keyTakeaways.map((t, i) => ({
      '@type': 'Question',
      name:    `Key takeaway ${i + 1}`,
      acceptedAnswer: { '@type': 'Answer', text: t },
    })),
  ],
} : null;

const wasUpdated = !!post.data.updatedAt &&
  post.data.updatedAt.getTime() > post.data.publishedAt.getTime();

// BreadcrumbList — every crawler uses this to place the article in
// the site's hierarchy. Google's rich-result eligibility depends on it.
const CLUSTER_LABEL: Record<string, string> = {
  'agent-safety':  'Agent safety',
  'verticals':     'Verticals',
  'comparison':    'Comparison',
  'deep-dive':     'Deep dive',
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type':    'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',
      item: 'https://aegistraces.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog',
      item: 'https://aegistraces.com/blog' },
    { '@type': 'ListItem', position: 3,
      name: CLUSTER_LABEL[post.data.cluster] ?? post.data.cluster,
      item: `https://aegistraces.com/blog#${post.data.cluster}` },
    { '@type': 'ListItem', position: 4, name: post.data.title, item: url },
  ],
};

// HowTo — only emitted when the article's frontmatter carries
// howToSteps. Google's How-To rich result + LLM step-extraction.
const howToLd = post.data.howToSteps && post.data.howToSteps.length > 0 ? {
  '@context': 'https://schema.org',
  '@type':    'HowTo',
  name:       post.data.title,
  description: post.data.description,
  totalTime:  post.data.howToDuration ?? undefined,
  step: post.data.howToSteps.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name:    s,
    text:    s,
  })),
} : null;

// ── Related posts (same cluster, excl. current) ─────────────────────
const related = (await getCollection('blog'))
  .filter(p => !p.data.draft && p.data.cluster === post.data.cluster && p.slug !== post.slug)
  .slice(0, 3);

// ── Citation formats ────────────────────────────────────────────────
// Auto-generated BibTeX + APA so anyone citing the article in a paper
// or blog post doesn't have to hand-write the fields. GEO bonus: LLMs
// scrape citation blocks and use them as ground truth for the article's
// canonical metadata.
const pubYear    = post.data.publishedAt.getFullYear();
const pubMonthDay = post.data.publishedAt.toLocaleDateString('en-US', {
  month: 'long', day: 'numeric',
});
const authorLastFirst = post.data.author === 'justin'
  ? 'Yuan, J.'
  : 'AEGIS Team';
const authorBib = post.data.author === 'justin'
  ? 'Yuan, Justin'
  : 'AEGIS Team';
const bibtexKey = `aegis-${post.slug}`;
const bibtex = `@misc{${bibtexKey},
  author    = {${authorBib}},
  title     = {${post.data.title.replace(/[{}]/g, '')}},
  year      = {${pubYear}},
  publisher = {AEGIS},
  url       = {${url}},
  note      = {${wasUpdated ? 'Updated ' + dateMod.slice(0, 10) : 'Published ' + datePub.slice(0, 10)}}
}`;
const apa = `${authorLastFirst} (${pubYear}, ${pubMonthDay}). ${post.data.title}. AEGIS. ${url}`;
---

<Layout title={`${post.data.title} — AEGIS`} description={post.data.description}>
  <Header current="blog" />

  {/* JSON-LD must be inline in <head>; Astro lets us put it anywhere
      and it ends up in the rendered HTML. Crawlers parse this. */}
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)}></script>
  {faqJsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>
  )}
  {howToLd && (
    <script type="application/ld+json" set:html={JSON.stringify(howToLd)}></script>
  )}

  <main class="post">
    <article class="container container-narrow">
      {/* Header */}
      <header class="post-head">
        <p class="cluster"><a href="/blog">Blog</a> · {post.data.cluster.replace('-', ' ')}</p>
        <h1>{post.data.title}</h1>
        <p class="answers-q"><strong>Answers:</strong> {post.data.answersQuery}</p>

        <div class="meta">
          <span class="meta-author">{author.name}</span>
          <span class="meta-sep">·</span>
          <time datetime={datePub}>
            {post.data.publishedAt.toLocaleDateString('en-US', {
              year: 'numeric', month: 'short', day: 'numeric',
            })}
          </time>
          {wasUpdated && (
            <>
              <span class="meta-sep">·</span>
              <span class="meta-updated">
                Updated{' '}
                <time datetime={dateMod}>
                  {post.data.updatedAt!.toLocaleDateString('en-US', {
                    year: 'numeric', month: 'short', day: 'numeric',
                  })}
                </time>
              </span>
            </>
          )}
          <span class="meta-sep">·</span>
          <span class="meta-words">{Math.round(wordCount / 200)} min read</span>
        </div>

        {post.data.headlineStat && (
          <p class="headline-stat">{post.data.headlineStat}</p>
        )}

        {/* One-sentence declarative answer — Perplexity / AI Overview
            / Gemini extract this verbatim. `.speakable` selector also
            hooks the SpeakableSpecification in JSON-LD. */}
        {post.data.oneSentenceAnswer && (
          <p class="speakable" itemprop="abstract">{post.data.oneSentenceAnswer}</p>
        )}
      </header>

      {/* Hero cover image — Unsplash photo when set, deterministic
          SVG fallback otherwise */}
      <div class="post-cover">
        <BlogCover
          cluster={post.data.cluster}
          seed={post.slug}
          size="hero"
          coverImage={post.data.coverImage}
          alt={post.data.title}
        />
      </div>

      {/* Key takeaways — GEO-canonical TL;DR. LLM crawlers extract
          this block when summarising the article. */}
      {post.data.keyTakeaways && post.data.keyTakeaways.length > 0 && (
        <aside class="takeaways" aria-label="Key takeaways">
          <p class="takeaways-label">Key takeaways</p>
          <ul>
            {post.data.keyTakeaways.map(t => <li>{t}</li>)}
          </ul>
        </aside>
      )}

      {/* Table of contents — auto-generated from H2s. Rendered as
          a nav so screen readers announce it correctly + LLM crawlers
          use it to build the section index. */}
      {toc.length > 2 && (
        <nav class="toc" aria-label="In this article">
          <p class="toc-label">In this article</p>
          <ol>
            {toc.map(h => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ol>
        </nav>
      )}

      {/* The markdown content */}
      <div class="content">
        <Content />
      </div>

      {/* Footer block */}
      <footer class="post-foot">
        <div class="cta">
          <a class="btn-secondary" href="/install">Install AEGIS</a>
          <a class="btn-secondary" href="/blog">All posts</a>
          <a class="btn-secondary" href="https://github.com/Justin0504/Aegis" rel="noopener" target="_blank">Star on GitHub</a>
        </div>

        {related.length > 0 && (
          <section class="related">
            <h2>Related</h2>
            <ul>
              {related.map(p => (
                <li>
                  <a href={`/blog/${p.slug}/`}>
                    <strong>{p.data.title}</strong>
                    <span>{p.data.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {/* Citation-copy: BibTeX + APA. LLM crawlers scrape these for
            canonical metadata; humans copy them into papers. */}
        <section class="cite">
          <h2>Cite this article</h2>
          <div class="cite-tabs">
            <details open>
              <summary>APA</summary>
              <pre class="cite-block"><code>{apa}</code></pre>
            </details>
            <details>
              <summary>BibTeX</summary>
              <pre class="cite-block"><code>{bibtex}</code></pre>
            </details>
          </div>
          <p class="cite-hint">
            See also the <a href="/blog/glossary">Glossary</a> for canonical
            definitions of every term used above.
          </p>
        </section>
      </footer>
    </article>
  </main>

  <Footer />

  <style>
    .post { padding: 4rem 0 5rem; }
    .post-head { padding-bottom: 2.5rem; border-bottom: 1px solid var(--hairline); }
    .cluster {
      font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase;
      color: var(--muted); margin: 0 0 1rem;
    }
    .cluster a { color: var(--text); text-decoration: none; }
    .cluster a:hover { text-decoration: underline; text-underline-offset: 3px; }
    .post-head h1 {
      font-family: var(--font-serif);
      font-size: 2.4rem;
      line-height: 1.15;
      letter-spacing: -0.015em;
      margin: 0 0 1rem;
    }
    .answers-q {
      color: var(--muted);
      font-size: 1.08rem;
      line-height: 1.5;
      max-width: 70ch;
      margin: 0 0 1.4rem;
    }
    .answers-q strong { color: var(--text); }
    .meta {
      color: var(--muted);
      font-size: 0.88rem;
      display: flex; gap: 0.5rem; flex-wrap: wrap;
      align-items: center;
    }
    .meta-sep { opacity: 0.5; }
    .meta-author { color: var(--text); font-weight: 500; }
    .headline-stat {
      margin-top: 1.6rem;
      padding: 0.85rem 1.1rem;
      background: var(--surface-2);
      border-left: 3px solid var(--text);
      font-family: ui-monospace, monospace;
      font-size: 0.92rem;
      color: var(--text);
      border-radius: 0 6px 6px 0;
      line-height: 1.5;
    }

    /* Speakable one-sentence answer — target for AI Overview /
       Perplexity / voice-assistant extraction. */
    .speakable {
      margin-top: 1.6rem;
      font-family: var(--font-serif);
      font-size: 1.28rem;
      line-height: 1.45;
      color: var(--text);
      letter-spacing: -0.005em;
      max-width: 62ch;
    }
    .meta-updated {
      color: var(--text);
      font-weight: 500;
    }

    .post-cover {
      margin: 2.5rem 0 1rem;
    }

    .takeaways {
      margin: 1.5rem 0 0;
      padding: 1.3rem 1.6rem 1.2rem;
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: 12px;
      max-width: 72ch;
    }
    .takeaways-label {
      font-size: 0.74rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      font-weight: 600;
      margin: 0 0 0.7rem;
    }
    .takeaways ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .takeaways li {
      position: relative;
      padding: 0.32rem 0 0.32rem 1.3rem;
      font-size: 0.98rem;
      line-height: 1.55;
      color: var(--text);
    }
    .takeaways li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.85rem;
      width: 0.6rem;
      height: 0.6rem;
      background: var(--text);
      border-radius: 2px;
      opacity: 0.6;
    }

    /* Table of contents */
    .toc {
      margin: 1.2rem 0 0;
      padding: 1rem 1.4rem 1rem 1.3rem;
      background: var(--surface-2);
      border-left: 3px solid var(--hairline);
      border-radius: 0 8px 8px 0;
      max-width: 72ch;
    }
    .toc-label {
      font-size: 0.74rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      font-weight: 600;
      margin: 0 0 0.5rem;
    }
    .toc ol {
      margin: 0;
      padding-left: 1.4rem;
      counter-reset: item;
    }
    .toc li {
      font-size: 0.94rem;
      line-height: 1.55;
      margin: 0.25rem 0;
      color: var(--text);
    }
    .toc a {
      color: var(--text);
      text-decoration: underline;
      text-decoration-color: var(--hairline);
      text-underline-offset: 3px;
    }
    .toc a:hover { text-decoration-color: var(--accent, #6b7e7f); }

    /* Ensure heading anchors have scroll offset for sticky header. */
    :global(h2[id]),
    :global(h3[id]) {
      scroll-margin-top: 5rem;
    }

    /* ── The actual prose styles ────────────────────────── */
    .content { padding: 2.5rem 0; }
    .content :global(h2) {
      font-family: var(--font-serif);
      font-size: 1.65rem;
      letter-spacing: -0.01em;
      margin: 2.6rem 0 1rem;
      line-height: 1.25;
    }
    .content :global(h3) {
      font-size: 1.18rem;
      font-weight: 600;
      margin: 1.8rem 0 0.7rem;
    }
    .content :global(p) {
      font-size: 1.05rem;
      line-height: 1.7;
      color: var(--text);
      margin: 0 0 1.2rem;
      max-width: 72ch;
    }
    .content :global(p code),
    .content :global(li code) {
      background: var(--surface-2);
      padding: 0.08rem 0.35rem;
      border-radius: 3px;
      font-family: ui-monospace, monospace;
      font-size: 0.92em;
    }
    .content :global(ul), .content :global(ol) {
      margin: 0 0 1.4rem;
      padding-left: 1.4rem;
      max-width: 70ch;
    }
    .content :global(li) {
      font-size: 1.02rem;
      line-height: 1.65;
      margin: 0.35rem 0;
    }
    .content :global(table) {
      border-collapse: collapse;
      margin: 1.4rem 0;
      width: 100%;
      max-width: 100%;
      font-size: 0.92rem;
    }
    .content :global(th), .content :global(td) {
      padding: 0.55rem 0.7rem;
      border-bottom: 1px solid var(--hairline);
      text-align: left;
    }
    .content :global(th) {
      font-weight: 600;
      background: var(--surface-2);
      letter-spacing: 0.02em;
    }
    .content :global(pre) {
      background: #1a1816;
      color: #d8d3c0;
      padding: 1.1rem 1.2rem;
      border-radius: 8px;
      overflow-x: auto;
      margin: 1.4rem 0;
      font-size: 0.86rem;
      line-height: 1.55;
    }
    .content :global(pre code) {
      background: transparent;
      padding: 0;
      font-family: ui-monospace, monospace;
    }
    .content :global(blockquote) {
      margin: 1.6rem 0;
      padding: 0.4rem 0 0.4rem 1.2rem;
      border-left: 3px solid var(--text);
      color: var(--text);
      font-style: italic;
      max-width: 70ch;
    }
    .content :global(blockquote em),
    .content :global(blockquote strong) {
      font-style: normal;
    }
    .content :global(hr) {
      border: 0;
      border-top: 1px solid var(--hairline);
      margin: 2rem 0;
    }
    .content :global(a) {
      color: var(--text);
      text-decoration: underline;
      text-decoration-color: var(--hairline);
      text-underline-offset: 3px;
    }
    .content :global(a:hover) { text-decoration-color: var(--accent); }

    /* Auto-annotation styles (rehype-annotate plugin) */
    .content :global(.fact) {
      font-variant-numeric: tabular-nums;
      font-weight: 500;
      color: var(--text);
      background: linear-gradient(180deg, transparent 60%, rgba(212, 181, 168, 0.35) 60%);
      padding: 0 0.15rem;
      border-radius: 2px;
    }
    .content :global(abbr[title]) {
      text-decoration: underline dotted var(--muted);
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
      cursor: help;
    }
    .content :global(a.dfn) {
      color: var(--text);
      text-decoration: underline dashed var(--muted);
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }
    .content :global(a.dfn:hover) {
      text-decoration-style: solid;
      text-decoration-color: var(--accent, #6b7e7f);
    }

    /* ── Footer ─────────────────────────────────────────── */
    .post-foot {
      border-top: 1px solid var(--hairline);
      padding-top: 2rem;
      margin-top: 1rem;
    }
    .cta {
      display: flex;
      gap: 0.7rem;
      margin-bottom: 3rem;
      flex-wrap: wrap;
    }
    .related h2 {
      font-family: var(--font-serif);
      font-size: 1.3rem;
      margin: 0 0 1rem;
    }
    .related ul { list-style: none; padding: 0; margin: 0; }
    .related li { border-top: 1px solid var(--hairline); }
    .related li:last-child { border-bottom: 1px solid var(--hairline); }
    .related a {
      display: block;
      padding: 1.1rem 0;
      text-decoration: none;
      color: var(--text);
    }
    .related strong { font-size: 1.02rem; font-weight: 500; }
    .related span {
      display: block;
      color: var(--muted);
      font-size: 0.88rem;
      margin-top: 0.25rem;
      line-height: 1.5;
    }

    /* Citation block */
    .cite {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid var(--hairline);
    }
    .cite h2 {
      font-family: var(--font-serif);
      font-size: 1.3rem;
      margin: 0 0 1rem;
      letter-spacing: -0.005em;
    }
    .cite-tabs details {
      margin-bottom: 0.6rem;
      border: 1px solid var(--hairline);
      border-radius: 8px;
      background: var(--surface);
      padding: 0;
    }
    .cite-tabs summary {
      cursor: pointer;
      padding: 0.6rem 0.9rem;
      font-size: 0.88rem;
      font-weight: 500;
      color: var(--text);
      user-select: none;
      list-style: none;
    }
    .cite-tabs summary::-webkit-details-marker { display: none; }
    .cite-tabs summary::before {
      content: '▸';
      display: inline-block;
