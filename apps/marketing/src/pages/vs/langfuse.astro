---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

// Langfuse is the reigning open-source LLM observability platform.
// Different category from AEGIS in principle (obs, not runtime
// gate) but buyers routinely conflate the two — this page pins
// down where they overlap and where the responsibilities split.
const CAPS = [
  { row: 'Trace collection + span linkage',        aegis: 'yes', lf: 'yes',       note: 'Both instrument LLM + tool calls and stitch parent/child traces.', depth: 'core' },
  { row: 'Runtime enforcement (block / pending)',  aegis: 'yes', lf: 'no',        note: 'AEGIS gates the call before it fires. Langfuse observes it after.', depth: 'core' },
  { row: 'Cryptographic audit chain (Merkle)',     aegis: 'yes', lf: 'no',        note: 'AEGIS ships Ed25519-signed transparency log. Langfuse stores traces in Postgres (or ClickHouse) — no third-party-verifiable chain.', depth: 'core' },
  { row: 'Workflow-anchored policies',             aegis: 'yes', lf: 'no',        note: 'Langfuse has no policy DSL — enforcement is not in scope.', depth: 'core' },
  { row: 'Compensator / rollback',                 aegis: 'yes', lf: 'no',        note: 'AEGIS ships a saga engine with binding-scoped compensators.', depth: 'core' },
  { row: 'Prompt versioning + eval harness',       aegis: 'partial', lf: 'yes',   note: 'Langfuse-native strength. AEGIS records prompt/response but does not offer prompt A/B or LLM-judge eval as a first-class primitive.', depth: 'core' },
  { row: 'EU AI Act evidence pack',                aegis: 'yes', lf: 'no',        note: 'Article 12-15 signed pack from AEGIS. Langfuse traces feed into your own compliance workflow.', depth: 'core' },
  { row: 'Air-gapped deploy',                      aegis: 'yes', lf: 'yes',       note: 'Both offer self-host. AEGIS ships NetworkPolicy in its Helm chart; Langfuse has a self-host guide but less-strict network isolation posture out of the box.', depth: 'core' },

  { row: 'Prompt playground UI',                   aegis: 'no',  lf: 'yes',       note: 'Langfuse ships a prompt/model playground. AEGIS scope stops at gateway + audit + compliance.', depth: 'detail' },
  { row: 'LLM-as-judge eval built-in',             aegis: 'partial', lf: 'yes',   note: 'AEGIS has an alignment/judge detector; Langfuse ships a fuller eval workflow with dataset management.', depth: 'detail' },
  { row: 'Dataset management + regression',        aegis: 'no',  lf: 'yes',       note: 'Langfuse-native. AEGIS does not currently manage eval datasets.', depth: 'detail' },
  { row: 'License',                                aegis: 'MIT (core)', lf: 'MIT', note: 'Both fully open-source. Both offer hosted paid tiers.', depth: 'detail' },
];
const CORE   = CAPS.filter((c) => c.depth === 'core');
const DETAIL = CAPS.filter((c) => c.depth === 'detail');
---

<Layout
  title="AEGIS vs Langfuse — Runtime firewall vs LLM observability"
  description="How AEGIS compares to Langfuse. Runtime enforcement + cryptographic audit + EU AI Act evidence pack vs LLM observability + prompt eval. Deploy both if you need both."
  ogImage="/og-image.png"
>
  <Header />
  <main>
    <section class="vs-hero">
      <div class="container container-narrow">
        <p class="eyebrow">Head to head · updated 2026-07</p>
        <h1>AEGIS <span class="vs-word">vs</span> Langfuse</h1>
        <p class="lede">
          These are <em>different categories</em>. Langfuse is the
          leading open-source LLM observability platform. AEGIS is a
          runtime firewall + compliance evidence layer. Buyers
          conflate them — this page pins down what's actually different
          and when you need both.
        </p>
        <p class="lede small">
          Written by the AEGIS team. Read the
          <a href="https://langfuse.com" target="_blank" rel="noopener">Langfuse docs</a>
          and decide for yourself.
        </p>
      </div>
    </section>

    <section class="vs-tldr">
      <div class="container">
        <h2>The 8 things buyers ask about first</h2>
        <div class="matrix">
          <div class="mrow head">
            <div>Capability</div>
            <div>AEGIS</div>
            <div>Langfuse</div>
          </div>
          {CORE.map((c) => (
            <div class="mrow">
              <div class="cap">
                <div class="cap-row">{c.row}</div>
                <div class="cap-note">{c.note}</div>
              </div>
              <div class={`v v-${c.aegis === 'no' ? 'no' : c.aegis === 'partial' ? 'partial' : 'yes'}`}>{c.aegis}</div>
              <div class={`v v-${c.lf === 'no' ? 'no' : c.lf === 'partial' ? 'partial' : 'yes'}`}>{c.lf}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="vs-deep">
      <div class="container container-narrow">
        <h2 class="section-h">Where the two products split</h2>

        <article class="diff">
          <span class="diff-num">01</span>
          <h3>Before vs after</h3>
          <p>
            The single most important difference. AEGIS runs in the
            request path — a tool call goes through the gateway before
            the LLM sees the result. Blocking a bad call means it
            never happens. Langfuse runs alongside — traces flow to
            it after the fact for analysis, but nothing gets
            intercepted. Firing an alert on an already-shipped
            hallucinated Stripe refund is not the same as blocking it.
          </p>
        </article>

        <article class="diff">
          <span class="diff-num">02</span>
          <h3>Cryptographic evidence vs analytical evidence</h3>
          <p>
            Langfuse's Postgres traces are for you to <em>analyze</em> —
            filter, chart, backtest. AEGIS's Merkle-anchored log is for
            you to <em>attest</em> — Ed25519 signature over the chain,
            offline-verifiable against the gateway's published public
            key. If your auditor asks "did this decision happen and was
            the record untampered", AEGIS answers in one JSON download.
            Langfuse would require you to build the attestation layer.
          </p>
        </article>

        <article class="diff">
          <span class="diff-num">03</span>
          <h3>Ship them together</h3>
          <p>
            Nothing stops you from running both. AEGIS's gateway can
            forward every decided call to Langfuse for
            product-analytics review while the AEGIS log holds the
            audit-of-record. That's the healthiest mature stack we've
            seen: <strong>AEGIS for runtime + compliance, Langfuse
            for prompt/eval iteration</strong>. Different jobs, different
            data models, complementary.
          </p>
        </article>
      </div>
    </section>

    <section class="vs-detail">
      <div class="container">
        <h2 class="section-h">Full capability matrix</h2>
        <div class="matrix">
          <div class="mrow head">
            <div>Capability</div>
            <div>AEGIS</div>
            <div>Langfuse</div>
          </div>
          {[...CORE, ...DETAIL].map((c) => (
            <div class="mrow">
              <div class="cap">
                <div class="cap-row">{c.row}</div>
                <div class="cap-note">{c.note}</div>
              </div>
              <div class={`v v-${c.aegis === 'no' ? 'no' : c.aegis === 'partial' ? 'partial' : 'yes'}`}>{c.aegis}</div>
              <div class={`v v-${c.lf === 'no' ? 'no' : c.lf === 'partial' ? 'partial' : 'yes'}`}>{c.lf}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="vs-picks">
      <div class="container">
        <h2 class="section-h">Honest picking guide</h2>
        <div class="picks-grid">
          <article class="pick pick-msft">
            <h3>Pick Langfuse when</h3>
            <ul>
              <li>Your #1 problem is <strong>prompt iteration</strong> — you need dataset management, prompt versioning, and LLM-judge eval as first-class.</li>
              <li>You're pre-launch, no compliance surface yet, and want to instrument agents for product analytics.</li>
              <li>Your team is small and one tool per problem is preferred over two.</li>
            </ul>
          </article>
          <article class="pick pick-aegis">
            <h3>Pick AEGIS when</h3>
            <ul>
              <li>You need to <strong>block a call before it fires</strong>, not observe it after.</li>
              <li>An <strong>auditor</strong> will want a signed evidence artifact (SOC 2 / HIPAA / EU AI Act).</li>
              <li>You need <strong>rollback</strong> for financial / PHI / deploy actions.</li>
              <li>You want <strong>workflow-anchored policies</strong> — same tool, different node, different rule.</li>
            </ul>
          </article>
        </div>
        <p class="pair-note">
          Or run both: gateway forwards decided calls to Langfuse for
          analytics review; AEGIS chain holds the audit-of-record.
        </p>
      </div>
    </section>

    <section class="vs-cta">
      <div class="container container-narrow">
        <h2>Try the AEGIS playground.</h2>
        <p>Compile an English rule and evaluate a tool call — no signup, all client-side.</p>
        <div class="cta-row">
          <a href="/demo" class="btn">Open playground →</a>
          <a href="/pricing" class="btn-secondary">Pricing</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <style>
    /* Shared vs-page styles are inlined here so each competitor page
       is self-contained — future refactor could extract to a
       shared partial once we have 4+ pages. */
    .eyebrow { font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); font-weight: 600; margin: 0 0 0.6rem; }
    .vs-hero { padding: 4.5rem 0 3rem; }
    .vs-hero h1 { font-family: var(--font-serif); font-size: clamp(2rem, 4.2vw, 3.2rem); font-weight: 400; letter-spacing: -0.01em; line-height: 1.15; margin: 0 0 1.2rem; }
    .vs-hero .vs-word { font-style: italic; color: var(--muted); font-weight: 400; }
    .vs-hero .lede { font-size: 1.15rem; color: var(--muted); max-width: 42rem; margin: 0.4rem 0 0.5rem; line-height: 1.5; }
    .vs-hero .lede em { font-style: italic; color: var(--text); }
    .vs-hero .lede.small { font-size: 0.9rem; }
    .vs-hero .lede a { color: var(--text); text-decoration: underline; text-decoration-color: var(--hairline-strong); }

    section.vs-tldr, section.vs-deep, section.vs-detail, section.vs-picks, section.vs-cta { padding: 3rem 0; }
    section.vs-tldr, section.vs-detail { background: var(--surface-2); border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
    .section-h, section.vs-tldr h2 { font-family: var(--font-serif); font-weight: 400; font-size: 1.75rem; letter-spacing: -0.01em; margin: 0 0 1.75rem; }

    .matrix { background: var(--surface); border: 1px solid var(--hairline); border-radius: 12px; overflow: hidden; }
    .mrow { display: grid; grid-template-columns: 2.4fr 1fr 1fr; gap: 0; align-items: start; border-bottom: 1px solid var(--hairline); }
    .mrow:last-child { border-bottom: none; }
    .mrow.head { background: var(--bg); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 600; color: var(--muted); }
    .mrow.head > div { padding: 0.8rem 1rem; }
    .mrow:not(.head) > div { padding: 0.9rem 1rem; }
    .cap-row { font-weight: 500; color: var(--text); font-size: 0.95rem; margin-bottom: 0.2rem; }
    .cap-note { color: var(--muted); font-size: 0.82rem; line-height: 1.5; }
    .v { display: flex; align-items: flex-start; font-size: 0.85rem; font-weight: 500; border-left: 1px solid var(--hairline); }
    .v-yes { color: var(--accent-positive); } .v-yes::before { content: '✓  '; font-weight: 700; margin-right: 0.15rem; }
    .v-no  { color: var(--accent-error); opacity: 0.9; } .v-no::before { content: '✗  '; font-weight: 700; margin-right: 0.15rem; }
    .v-partial { color: var(--accent-warn); } .v-partial::before { content: '◐  '; font-weight: 700; margin-right: 0.15rem; }
    @media (max-width: 780px) { .mrow { grid-template-columns: 1fr; } .v { border-left: none; border-top: 1px solid var(--hairline); } }

    .diff { position: relative; padding: 1.5rem 1.5rem 1.75rem 4.5rem; margin-bottom: 1.25rem; background: var(--surface); border: 1px solid var(--hairline); border-radius: 12px; }
    .diff-num { position: absolute; top: 1.5rem; left: 1.5rem; font-family: var(--font-serif); font-size: 1.6rem; color: var(--accent-warn); }
    .diff h3 { font-family: var(--font-serif); font-weight: 400; font-size: 1.35rem; margin: 0 0 0.75rem; }
    .diff p { color: var(--text); font-size: 0.95rem; line-height: 1.6; margin: 0 0 0.75rem; }
    .diff p em { font-style: italic; color: var(--accent-warn); }
    .diff p strong { font-weight: 600; }

    .picks-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    @media (max-width: 780px) { .picks-grid { grid-template-columns: 1fr; } }
    .pick { background: var(--surface); border: 1px solid var(--hairline); border-radius: 12px; padding: 1.5rem; }
    .pick h3 { font-family: var(--font-serif); font-weight: 400; font-size: 1.2rem; margin: 0 0 1rem; }
    .pick-aegis { border-color: color-mix(in oklab, var(--accent-warn) 45%, var(--hairline)); }
    .pick-aegis h3 { color: color-mix(in oklab, var(--accent-warn) 90%, var(--text)); }
    .pick ul { color: var(--text); font-size: 0.9rem; line-height: 1.6; padding-left: 1.15rem; margin: 0; }
    .pick ul li { margin-bottom: 0.5rem; }
    .pick ul li strong { font-weight: 600; }
    .pair-note { margin: 1.5rem auto 0; text-align: center; color: var(--muted); font-size: 0.9rem; max-width: 42rem; }

    section.vs-cta { text-align: center; background: var(--surface-2); border-top: 1px solid var(--hairline); }
    section.vs-cta h2 { font-family: var(--font-serif); font-weight: 400; font-size: 2rem; margin: 0 0 0.5rem; }
    section.vs-cta p { color: var(--muted); margin: 0 0 1.5rem; }
    .cta-row { display: inline-flex; gap: 0.75rem; }
  </style>
</Layout>
