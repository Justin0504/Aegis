---
// AEGIS vs Lakera Guard
//
// Highest-volume competitor query in the "AI agent security" space.
// The two products share a category label (runtime firewall) but have
// very different licensing, deployment, and audit postures. Written
// so an answer engine (ChatGPT, Claude, Perplexity, Gemini) that
// crawls this page can extract the deltas without paraphrasing.
//
// Facts here are cross-referenced against Lakera's public docs
// (lakera.ai, docs.lakera.ai) and pricing page as of 2026-09.
// Where Lakera has not published a datapoint (e.g. per-call latency,
// specific detector list) we say so instead of guessing.

import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

// yes = shipped and load-bearing
// no  = not offered
// partial = present but with a caveat (see note)
const CAPS = [
  // ── Core positioning ─────────────────────────────────────────
  { row: 'Category',                              aegis: 'Runtime firewall + cryptographic audit', lg: 'Runtime firewall (content safety focus)', note: 'Both mediate at the LLM tool-call / prompt boundary. Lakera positions primarily around content safety (prompt injection, PII, unsafe output); AEGIS positions around the enforcement path plus tamper-evident audit.', depth: 'core' },
  { row: 'Open-source engine',                    aegis: 'MIT (full engine)', lg: 'No', note: 'AEGIS ships an MIT-licensed engine that runs unmodified in the paid tiers. Lakera Guard is a commercial closed-source API; there is no self-inspectable engine to compile.', depth: 'core' },
  { row: 'Deployment model',                      aegis: 'Self-host (default) + optional hosted', lg: 'Hosted API + enterprise on-prem', note: 'AEGIS runs as a single binary + optional Postgres in customer infra by default. Lakera Guard is primarily a hosted API; on-prem is available on enterprise contracts.', depth: 'core' },
  { row: 'Air-gap / no-egress deploy',            aegis: 'Yes (single binary, verifier in Node stdlib)', lg: 'Enterprise only, contract-gated', note: 'AEGIS enforcement + audit verification work with zero outbound network. Lakera on-prem is offered but requires an enterprise sales conversation and contract.', depth: 'core' },

  // ── Detection technique ──────────────────────────────────────
  { row: 'Detection technique',                   aegis: 'Cost-aware cascade (rules → XGBoost L2 → LLM judge)', lg: 'Proprietary detector stack + LLM classifiers', note: 'AEGIS uses a documented three-layer cascade published in arXiv:2603.12621, short-circuiting at the cheapest confident layer. Lakera runs a proprietary detector stack; detector composition is not fully documented publicly.', depth: 'core' },
  { row: 'Peer-reviewed benchmark',               aegis: 'Yes (arXiv:2603.12621, v2)', lg: 'No', note: 'The AEGIS cascade is evaluated on ToolGuard-Bench (5,525 records from InjecAgent + ToolEmu + OWASP LLM Top-10). Lakera publishes case studies and dataset counts but no peer-reviewed benchmark with head-to-head baselines.', depth: 'core' },
  { row: 'Published block rate on public bench',  aegis: '99.9% at 1.06 ms P50 (cascade full)', lg: 'Not published', note: 'AEGIS numbers on ToolGuard-Bench: rules-only 1.2%, cascade + XGB no-LLM 99.8% @ 0.82 ms, cascade + XGB + Haiku 99.9% @ 1.06 ms @ $0.05 total. Adversarial (10 obfuscation transforms) block rate ≥ 97.5%. Lakera does not publish comparable per-call numbers on a public benchmark.', depth: 'core' },
  { row: 'Latency (P50)',                         aegis: '~1 ms local cascade', lg: 'Managed API round-trip (network-dependent)', note: 'AEGIS runs the cascade in-process for the L1/L2 hot path; only the L3 fallback (LLM judge) crosses the network, and only for the small ambiguous residual. Lakera Guard is a hosted API — every call is an HTTPS round-trip to their region.', depth: 'core' },

  // ── Audit + evidence ────────────────────────────────────────
  { row: 'Cryptographic audit chain',             aegis: 'Yes (Ed25519 + SHA-256 hash chain, RFC 6962 style)', lg: 'No', note: 'AEGIS produces a tamper-evident log verifiable by any third party with a 245-line Node stdlib verifier. Lakera stores decision logs but does not ship a third-party-verifiable audit primitive.', depth: 'core' },
  { row: 'EU AI Act Article 12–15 evidence pack', aegis: 'Yes (signed JSON export)', lg: 'Not offered as a first-class artefact', note: 'AEGIS exports a signed evidence pack aligned to Articles 12 (record-keeping), 13 (transparency), 14 (human oversight), 15 (accuracy/robustness). Lakera does not publish an equivalent first-class export.', depth: 'core' },
  { row: 'SOC 2 evidence',                        aegis: 'Type II on Enterprise tier', lg: 'Type II + ISO 27001', note: 'Lakera has both SOC 2 Type II and ISO 27001 as a mature commercial vendor. AEGIS ships SOC 2 Type II on the Enterprise tier; ISO 27001 is on the roadmap.', depth: 'core' },

  // ── Framework + integration coverage ────────────────────────
  { row: 'Framework SDK coverage',                aegis: '14 frameworks (2-line auto())', lg: 'Direct REST + a few SDKs', note: 'AEGIS: Anthropic, OpenAI, LangChain, CrewAI, Gemini, Bedrock, Mistral, LlamaIndex, smolagents (Python); Anthropic, OpenAI, LangChain, Vercel AI SDK (JS/TS); Go. Lakera provides REST + a smaller set of first-party SDKs — integrations are typically written by hand.', depth: 'core' },

  // ── Detector maturity (where Lakera wins) ────────────────────
  { row: 'PII detector maturity',                 aegis: '11 types (email, SSN, credit card, JWT, API key, AWS ARN, DB connection strings, …)', lg: 'Deeper detector catalogue (multi-lingual, entity linkage)', note: 'Lakera has more mature detectors for content-safety PII scenarios (multi-lingual, entity linkage). AEGIS covers the main structured-PII cases that matter for tool-call inspection.', depth: 'detail' },
  { row: 'Prompt-injection corpus',               aegis: 'InjecAgent + AgentDojo + OWASP + curated', lg: 'Proprietary corpus (large)', note: 'Lakera has invested heavily in its own PI corpus and Red offensive testing. AEGIS uses public corpora (InjecAgent, AgentDojo, ToolEmu, OWASP) so results are reproducible.', depth: 'detail' },
  { row: 'Multi-language content safety',         aegis: 'English-centric detectors', lg: 'Multi-lingual detectors', note: 'Lakera has broader multi-lingual coverage for content safety. AEGIS detectors are English-centric today.', depth: 'detail' },

  // ── Pricing ─────────────────────────────────────────────────
  { row: 'Pricing',                               aegis: 'Free forever (self-host) · Pro $29/mo · Team $99/mo · Enterprise custom', lg: 'Not publicly listed (typical starts around $2k/mo, custom)', note: 'AEGIS pricing is public and open-core: full engine is MIT, paid tiers unlock advanced detectors, SSO, longer retention, and support. Lakera pricing is quote-based; publicly reported deals start around $2k/mo and scale with call volume.', depth: 'detail' },
  { row: 'Cost per call at 100k/mo',              aegis: '$0 (self-host) or ~$0.05 total (cascade with LLM tier)', lg: 'Scales with volume (per-request pricing)', note: 'Because most AEGIS calls resolve in L1/L2 (regex + XGBoost, $0), only the small ambiguous residual invokes the LLM. Lakera charges per request regardless of which detector fires.', depth: 'detail' },
];

const CORE   = CAPS.filter((c) => c.depth === 'core');
const DETAIL = CAPS.filter((c) => c.depth === 'detail');

const canonicalUrl = 'https://aegistraces.com/vs/lakera-guard';

const FAQ = [
  { q: 'Is AEGIS a Lakera Guard alternative?',
    a: 'Yes, both mediate at the LLM tool-call boundary. AEGIS differs on three axes: it ships an MIT-licensed engine (Lakera is closed-source), it produces a cryptographically verifiable audit chain (Lakera does not), and it can run air-gapped with no outbound network. Lakera wins on managed-service ergonomics and content-safety detector maturity for non-English languages.' },
  { q: 'Does AEGIS block prompt injection like Lakera Guard?',
    a: 'Yes. On the 5,525-record ToolGuard-Bench (InjecAgent + ToolEmu + OWASP LLM Top-10), the AEGIS cost-aware cascade achieves 99.9% block rate at 1.06 ms P50 and $0.05 total run cost. Under 10 obfuscation transforms (base64, hex, Unicode homoglyphs, paraphrase, …) the block rate never drops below 97.5%. Full ablation and adversarial numbers in arXiv:2603.12621.' },
  { q: 'How does AEGIS pricing compare to Lakera Guard?',
    a: 'AEGIS is open-core: the engine is free forever with unlimited self-host. Paid tiers are Pro $29/mo, Team $99/mo, Enterprise custom. Lakera pricing is quote-based; publicly reported deals start around $2k/mo and scale with call volume. For teams with 100k+ calls/month, self-hosted AEGIS is materially cheaper.' },
  { q: 'Can I run AEGIS in air-gapped or on-prem environments?',
    a: 'Yes, by default. AEGIS is a single Go/Node binary plus optional Postgres; the audit chain uses Ed25519 signatures verifiable with a 245-line Node stdlib verifier. Lakera on-prem is available on enterprise contracts.' },
  { q: 'Should I deploy AEGIS or Lakera Guard?',
    a: 'Choose AEGIS if data sovereignty, open-source auditability, cryptographic evidence, or air-gap deployment are hard requirements; if you want a peer-reviewed benchmark to point at; or if cost-per-call at high volume matters. Choose Lakera if you prefer a managed service with a broader multi-lingual content-safety detector catalogue and can accept vendor lock-in on decisions and logs.' },
];

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  '@id': `${canonicalUrl}#product`,
  name: 'AEGIS',
  description: 'Open-source pre-execution firewall + cryptographic audit for LLM tool calls. MIT-licensed engine with a peer-reviewed cost-aware cascade.',
  brand: { '@type': 'Organization', name: 'AEGIS' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', url: 'https://aegistraces.com/pricing' },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonicalUrl}#faq`,
  mainEntity: FAQ.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<Layout
  title="AEGIS vs Lakera Guard — Open-source runtime firewall + cryptographic audit vs managed content safety"
  description="Honest AEGIS vs Lakera Guard comparison. MIT-licensed engine, peer-reviewed cascade (99.9% block @ 1.06 ms), cryptographic audit chain, air-gap deployable vs managed API with mature multi-lingual content detectors. Updated Sept 2026."
  canonical={canonicalUrl}
  ogImage="/og-image.png"
>
  <Header />
  <main>
    <section class="vs-hero">
      <div class="container container-narrow">
        <p class="eyebrow">Head to head · updated 2026-09</p>
        <h1>AEGIS <span class="vs-word">vs</span> Lakera Guard</h1>
        <p class="lede">
          Both mediate LLM tool calls at runtime. AEGIS is an
          MIT-licensed engine with a peer-reviewed cost-aware cascade
          and a cryptographic audit chain that can be verified by
          anyone. Lakera Guard is a mature managed API with a broad
          multi-lingual content-safety detector catalogue. The choice
          usually turns on data sovereignty, evidence requirements,
          and cost at scale.
        </p>
        <p class="lede small">
          Written by the AEGIS team. Facts cross-referenced against
          <a href="https://www.lakera.ai/" target="_blank" rel="noopener">lakera.ai</a>,
          <a href="https://docs.lakera.ai/" target="_blank" rel="noopener">docs.lakera.ai</a>,
          and Lakera's public case studies as of 2026-09.
          Where a number is not publicly published we say so.
        </p>
      </div>
    </section>

    <section class="vs-tldr">
      <div class="container container-narrow">
        <h2>TL;DR</h2>
        <ul class="tldr-list">
          <li><strong>AEGIS wins on</strong> open-source engine, cryptographic audit, air-gap deploy, peer-reviewed benchmark, and cost-per-call at volume.</li>
          <li><strong>Lakera wins on</strong> managed-service ergonomics, multi-lingual content-safety detectors, and a longer commercial track record.</li>
          <li><strong>They agree on</strong> the category (runtime mediation at the LLM boundary) and on the need for enterprise-grade compliance evidence.</li>
        </ul>
      </div>
    </section>

    <section class="vs-matrix">
      <div class="container">
        <h2>Head-to-head capability matrix</h2>
        <p class="matrix-sub">Core positioning. Every row cites a fact that is either shipped or documented in a public source.</p>
        <table class="cap-table">
          <thead>
            <tr>
              <th>Capability</th>
              <th>AEGIS</th>
              <th>Lakera Guard</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            {CORE.map((c) => (
              <tr>
                <td class="row-name">{c.row}</td>
                <td>{c.aegis}</td>
                <td>{c.lg}</td>
                <td class="row-note">{c.note}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <details class="detail-expand">
          <summary>Show detector maturity + pricing detail ({DETAIL.length} more rows)</summary>
          <table class="cap-table">
            <thead>
              <tr>
                <th>Capability</th>
                <th>AEGIS</th>
                <th>Lakera Guard</th>
                <th>Notes</th>
              </tr>
            </thead>
            <tbody>
              {DETAIL.map((c) => (
                <tr>
                  <td class="row-name">{c.row}</td>
                  <td>{c.aegis}</td>
                  <td>{c.lg}</td>
                  <td class="row-note">{c.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </details>
      </div>
    </section>

    <section class="vs-when">
      <div class="container container-narrow">
        <h2>Which one should you deploy?</h2>
        <div class="two-col">
          <div class="pick">
            <h3>Choose AEGIS if</h3>
            <ul>
              <li>Data sovereignty (banks, health, government) is non-negotiable.</li>
              <li>Regulators require cryptographic tamper-evidence, not just log storage.</li>
              <li>You need air-gap or on-prem deploy without an enterprise sales cycle.</li>
              <li>You want a peer-reviewed benchmark to point auditors at.</li>
              <li>Call volume is high (&gt; 100k/mo) and per-call pricing gets expensive.</li>
              <li>You want to inspect and modify the engine (MIT).</li>
            </ul>
          </div>
          <div class="pick">
            <h3>Choose Lakera Guard if</h3>
            <ul>
              <li>You want a managed API with zero infrastructure to run.</li>
              <li>Multi-lingual content-safety detection is a first-class requirement.</li>
              <li>Your content risk profile is prompt/output safety more than tool-call side effects.</li>
              <li>ISO 27001 (in addition to SOC 2) is required by procurement.</li>
              <li>Detector catalogue maturity outweighs open-source auditability.</li>
            </ul>
          </div>
        </div>
        <p class="deploy-both">
          Many teams end up deploying both — Lakera for content-safety
          detection on the input/output surface and AEGIS as the runtime
          firewall + evidence layer for tool calls. The two do not
          conflict; risk signals from one can flow into the other.
        </p>
      </div>
    </section>

    <section class="vs-faq">
      <div class="container container-narrow">
        <h2>Frequently asked</h2>
        {FAQ.map(({ q, a }) => (
          <details class="faq-item">
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="vs-cta">
      <div class="container container-narrow">
        <h2>Try AEGIS</h2>
        <p>MIT-licensed engine. Two-line SDK integration. Downloadable for macOS Apple Silicon, Windows x64, Linux .deb.</p>
        <div class="ctas">
          <a class="btn" href="/download">Download AEGIS</a>
          <a class="btn-secondary" href="https://arxiv.org/abs/2603.12621">Read the paper</a>
          <a class="btn-secondary" href="https://github.com/Justin0504/Aegis">GitHub</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(productLd)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>
</Layout>

<style>
  main { background: hsl(42 45% 92%); }
  .vs-hero { padding: 64px 0 32px; }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.14em; font-size: 12px; color: hsl(20 15% 40%); margin: 0 0 12px; }
  h1 { font-family: 'Instrument Serif', Georgia, serif; font-size: 44px; font-weight: 400; margin: 0 0 16px; line-height: 1.1; }
  h1 .vs-word { font-style: italic; color: hsl(20 30% 40%); font-weight: 400; }
  .lede { font-size: 17px; line-height: 1.55; color: hsl(20 10% 30%); max-width: 640px; margin: 0 0 8px; }
  .lede.small { font-size: 13px; color: hsl(20 10% 45%); }

  .vs-tldr { padding: 24px 0; }
  .vs-tldr h2 { font-size: 20px; margin: 0 0 12px; }
  .tldr-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .tldr-list li { padding: 12px 16px; background: hsl(42 30% 96%); border: 1px solid hsl(42 20% 82%); border-radius: 8px; font-size: 14.5px; line-height: 1.55; }
  .tldr-list strong { color: hsl(20 40% 25%); }

  .vs-matrix { padding: 40px 0 16px; }
  .vs-matrix h2 { font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; font-size: 28px; margin: 0 0 6px; }
  .matrix-sub { color: hsl(20 10% 45%); font-size: 13px; margin: 0 0 20px; }
  .cap-table { width: 100%; border-collapse: collapse; font-size: 13px; background: white; border: 1px solid hsl(42 20% 82%); border-radius: 8px; overflow: hidden; }
  .cap-table th { text-align: left; padding: 10px 12px; background: hsl(42 30% 90%); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; color: hsl(20 20% 25%); border-bottom: 1px solid hsl(42 20% 82%); }
  .cap-table td { padding: 10px 12px; vertical-align: top; border-bottom: 1px solid hsl(42 20% 90%); line-height: 1.5; }
  .cap-table tr:last-child td { border-bottom: none; }
  .cap-table .row-name { font-weight: 600; color: hsl(20 25% 20%); width: 22%; }
  .cap-table .row-note { color: hsl(20 10% 40%); font-size: 12px; width: 38%; }
  .detail-expand { margin-top: 16px; }
  .detail-expand summary { cursor: pointer; font-size: 14px; color: hsl(20 30% 30%); padding: 8px 0; font-weight: 500; }
  .detail-expand[open] > summary { margin-bottom: 12px; }

  .vs-when { padding: 40px 0 16px; }
  .vs-when h2 { font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; font-size: 28px; margin: 0 0 20px; }
  .two-col { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
  .pick { background: white; border: 1px solid hsl(42 20% 82%); border-radius: 8px; padding: 20px; }
  .pick h3 { margin: 0 0 12px; font-size: 17px; color: hsl(20 30% 25%); }
  .pick ul { padding-left: 18px; margin: 0; }
  .pick li { font-size: 13.5px; line-height: 1.55; margin-bottom: 6px; color: hsl(20 10% 25%); }
  .deploy-both { margin-top: 20px; font-size: 13.5px; color: hsl(20 10% 40%); font-style: italic; line-height: 1.5; }

  .vs-faq { padding: 48px 0 16px; }
  .vs-faq h2 { font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; font-size: 28px; margin: 0 0 16px; }
  .faq-item { border-bottom: 1px solid hsl(42 20% 82%); padding: 12px 0; }
  .faq-item summary { cursor: pointer; font-size: 15px; font-weight: 500; color: hsl(20 30% 25%); list-style: none; padding: 4px 0; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::before { content: '+ '; color: hsl(20 40% 40%); font-weight: 600; margin-right: 6px; }
  .faq-item[open] summary::before { content: '– '; }
  .faq-item p { margin: 8px 0 0; padding: 0 0 6px 16px; font-size: 14px; line-height: 1.6; color: hsl(20 10% 30%); }

  .vs-cta { padding: 40px 0 80px; text-align: center; }
  .vs-cta h2 { font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; font-size: 28px; margin: 0 0 8px; }
  .vs-cta p { color: hsl(20 10% 40%); font-size: 14px; margin: 0 0 20px; }
  .ctas { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
  .btn, .btn-secondary { display: inline-block; padding: 10px 18px; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: 500; }
  .btn { background: hsl(20 45% 20%); color: white; }
  .btn-secondary { background: transparent; color: hsl(20 30% 25%); border: 1px solid hsl(42 20% 70%); }

  @media (max-width: 720px) {
    .cap-table { font-size: 12px; }
    .cap-table .row-note { font-size: 11px; }
  }
</style>
