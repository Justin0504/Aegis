---
// AEGIS vs NVIDIA NeMo Guardrails
//
// NeMo Guardrails is NVIDIA's Apache-2.0 conversational safety
// framework built around the Colang DSL for dialog flow control.
// It's often mentioned in the same breath as AEGIS but solves a
// different problem: NeMo shapes the conversation, AEGIS gates
// the tool-call side effects.
//
// Cross-referenced against docs.nvidia.com/nemo/guardrails and
// github.com/NVIDIA/NeMo-Guardrails as of 2026-09.

import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const CAPS = [
  { row: 'Category',                              aegis: 'Runtime firewall + cryptographic audit', ng: 'Conversational safety / dialog flow control', note: 'AEGIS gates tool calls at the execution boundary. NeMo Guardrails uses the Colang DSL to constrain dialog flow (topical rails, input/output rails, retrieval rails, execution rails).', depth: 'core' },
  { row: 'Runtime enforcement (block tool call)', aegis: 'Yes (pre-execution block)', ng: 'Yes (via execution rails, DSL-driven)', note: 'Both can block tool execution. NeMo does it through a Colang rule the developer writes; AEGIS does it through a policy DSL + trained classifier + LLM judge cascade.', depth: 'core' },
  { row: 'Programming model',                     aegis: 'JSON Schema policies + 2-line SDK auto()', ng: 'Colang (Python-embedded DSL for dialog rules)', note: 'AEGIS: declarative JSON Schema, no new language to learn. NeMo: write Colang rules (novel DSL) that describe conversational flows and rails.', depth: 'core' },
  { row: 'License',                               aegis: 'MIT (core)', ng: 'Apache-2.0', note: 'Both fully open-source.', depth: 'core' },
  { row: 'Deployment',                            aegis: 'Self-host + hosted', ng: 'Self-host (library or NIM microservice)', note: 'AEGIS runs as a binary + optional Postgres. NeMo ships as a Python library and as a NIM inference microservice.', depth: 'core' },
  { row: 'Cryptographic audit chain',             aegis: 'Yes (Ed25519 + SHA-256, RFC 6962 style)', ng: 'No', note: 'AEGIS ships a tamper-evident log verifiable by third parties. NeMo focuses on runtime enforcement, not evidence generation.', depth: 'core' },
  { row: 'Peer-reviewed benchmark',               aegis: 'Yes (arXiv:2603.12621)', ng: 'No (docs-driven)', note: 'AEGIS publishes head-to-head numbers on ToolGuard-Bench. NeMo publishes technical reports and blog posts; no peer-reviewed gateway benchmark.', depth: 'core' },
  { row: 'Human-in-the-loop approval queue',      aegis: 'Yes (Compliance Cockpit)', ng: 'No (not in scope)', note: 'AEGIS routes ambiguous / high-risk calls to a reviewer UI. NeMo returns a rail decision to the caller.', depth: 'core' },
  { row: 'EU AI Act / SOC 2 evidence pack',       aegis: 'Yes (Article 12-15 signed export)', ng: 'No', note: 'AEGIS emits a signed compliance pack. NeMo does not — this is an add-on the deployer builds on top.', depth: 'core' },
  { row: 'Dialog-flow control (topical rails)',   aegis: 'No', ng: 'Yes (Colang native strength)', note: 'NeMo excels at conversational flow constraints ("do not discuss competitors", "always answer in Spanish first"). AEGIS scope is tool-call enforcement, not dialog shaping.', depth: 'core' },
  { row: 'Framework SDK coverage',                aegis: '14 (2-line auto())', ng: 'LangChain integration + REST', note: 'AEGIS: Anthropic, OpenAI, LangChain, CrewAI, Gemini, Bedrock, Mistral, LlamaIndex, smolagents, Vercel AI SDK, Go. NeMo integrates primarily via LangChain and its own runner.', depth: 'detail' },
  { row: 'Retrieval / RAG safety rails',          aegis: 'Partial (via detectors)', ng: 'Yes (retrieval rails are a first-class primitive)', note: 'NeMo has explicit retrieval rails. AEGIS treats retrieval as another tool call.', depth: 'detail' },
];

const CORE   = CAPS.filter((c) => c.depth === 'core');
const DETAIL = CAPS.filter((c) => c.depth === 'detail');

const canonicalUrl = 'https://aegistraces.com/vs/nemo-guardrails';

const FAQ = [
  { q: 'Is AEGIS a NeMo Guardrails alternative?',
    a: 'They overlap on the "block risky tool call" scenario but sit at different layers. NeMo Guardrails shapes conversational flow with the Colang DSL — great for topical rails, input/output rails, and retrieval rails. AEGIS is a runtime firewall on the tool-call execution path with a cryptographic audit chain and human-review queue. Many production teams deploy both.' },
  { q: 'Do I need Colang to use AEGIS?',
    a: 'No. AEGIS policies are declarative JSON Schema (with an optional natural-language authoring UI); there is no new language to learn. NeMo requires Colang for its rules.' },
  { q: 'Which one has better prompt-injection defence?',
    a: 'On the ToolGuard-Bench runtime path, AEGIS is the only system that publishes head-to-head numbers (99.9% block at 1.06 ms P50). NeMo\'s input rails can block obvious prompt-injection attempts before they reach the model; AEGIS blocks them at the tool-call boundary after they cause the model to emit a malicious call. Different points of intervention.' },
  { q: 'Can I use them together?',
    a: 'Yes. A common pattern: NeMo input rails filter user turns for obvious PI + topical rails constrain the conversation → the model produces tool calls → AEGIS mediates each tool call with cascade classification + cryptographic audit → human reviewer approves pending calls. NeMo\'s input safety + AEGIS\'s execution-path enforcement are additive.' },
  { q: 'Is NeMo Guardrails free?',
    a: 'Yes, Apache-2.0. NVIDIA also offers NIM microservice deployment for enterprise. AEGIS is MIT for the core engine with open-core paid tiers.' },
];

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  '@id': `${canonicalUrl}#product`,
  name: 'AEGIS',
  description: 'MIT-licensed pre-execution firewall for LLM tool calls with peer-reviewed cost-aware cascade and cryptographic audit chain.',
  brand: { '@type': 'Organization', name: 'AEGIS' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', url: 'https://aegistraces.com/pricing' },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonicalUrl}#faq`,
  mainEntity: FAQ.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<Layout
  title="AEGIS vs NeMo Guardrails — Runtime tool-call firewall vs conversational flow control (2026)"
  description="AEGIS mediates the LLM tool-call execution path with a peer-reviewed cost-aware cascade and cryptographic audit chain. NVIDIA NeMo Guardrails uses the Colang DSL to shape conversational flow. Head-to-head matrix + honest deltas + FAQ."
  canonical={canonicalUrl}
  ogImage="/og-image.png"
>
  <Header />
  <main>
    <section class="vs-hero">
      <div class="container container-narrow">
        <p class="eyebrow">Head to head · updated 2026-09</p>
        <h1>AEGIS <span class="vs-word">vs</span> NeMo Guardrails</h1>
        <p class="lede">
          Different points of intervention. NVIDIA NeMo Guardrails
          uses the Colang DSL to shape conversational flow — topical
          rails, input/output rails, retrieval rails. AEGIS is a
          runtime firewall on the tool-call execution path with a
          cryptographic audit chain. Common pattern: NeMo shapes the
          dialog, AEGIS gates the side effects.
        </p>
        <p class="lede small">
          Written by the AEGIS team. Facts cross-referenced against
          <a href="https://docs.nvidia.com/nemo/guardrails" target="_blank" rel="noopener">docs.nvidia.com/nemo/guardrails</a>
          and <a href="https://github.com/NVIDIA/NeMo-Guardrails" target="_blank" rel="noopener">github.com/NVIDIA/NeMo-Guardrails</a>
          as of 2026-09.
        </p>
      </div>
    </section>

    <section class="vs-tldr">
      <div class="container container-narrow">
        <h2>TL;DR</h2>
        <ul class="tldr-list">
          <li><strong>NeMo Guardrails</strong> = <em>dialog flow</em>: Colang DSL for topical / input / output / retrieval / execution rails. Great for content shaping and conversation constraints.</li>
          <li><strong>AEGIS</strong> = <em>tool-call firewall</em>: pre-execution block, cost-aware cascade (rules → XGBoost → LLM), cryptographic audit chain, human-review queue.</li>
          <li><strong>Together</strong>: NeMo input rails filter the user turn → model emits tool call → AEGIS mediates the call → reviewer approves pending. Additive, not competing.</li>
        </ul>
      </div>
    </section>

    <section class="vs-matrix">
      <div class="container">
        <h2>Head-to-head capability matrix</h2>
        <table class="cap-table">
          <thead>
            <tr>
              <th>Capability</th>
              <th>AEGIS</th>
              <th>NeMo Guardrails</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            {CORE.map((c) => (
              <tr>
                <td class="row-name">{c.row}</td>
                <td>{c.aegis}</td>
                <td>{c.ng}</td>
                <td class="row-note">{c.note}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <details class="detail-expand">
          <summary>Show framework + retrieval detail ({DETAIL.length} more rows)</summary>
          <table class="cap-table">
            <thead>
              <tr>
                <th>Capability</th>
                <th>AEGIS</th>
                <th>NeMo Guardrails</th>
                <th>Notes</th>
              </tr>
            </thead>
            <tbody>
              {DETAIL.map((c) => (
                <tr>
                  <td class="row-name">{c.row}</td>
                  <td>{c.aegis}</td>
                  <td>{c.ng}</td>
                  <td class="row-note">{c.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </details>
      </div>
    </section>

    <section class="vs-faq">
      <div class="container container-narrow">
        <h2>Frequently asked</h2>
        {FAQ.map(({ q, a }) => (
          <details class="faq-item">
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="vs-cta">
      <div class="container container-narrow">
        <h2>Try AEGIS</h2>
        <p>MIT-licensed engine. Deploys alongside NeMo Guardrails.</p>
        <div class="ctas">
          <a class="btn" href="/download">Download AEGIS</a>
          <a class="btn-secondary" href="https://arxiv.org/abs/2603.12621">Read the paper</a>
          <a class="btn-secondary" href="https://github.com/Justin0504/Aegis">GitHub</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(productLd)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>
</Layout>

<style>
  main { background: hsl(42 45% 92%); }
  .vs-hero { padding: 64px 0 32px; }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.14em; font-size: 12px; color: hsl(20 15% 40%); margin: 0 0 12px; }
  h1 { font-family: 'Instrument Serif', Georgia, serif; font-size: 44px; font-weight: 400; margin: 0 0 16px; line-height: 1.1; }
  h1 .vs-word { font-style: italic; color: hsl(20 30% 40%); font-weight: 400; }
  .lede { font-size: 17px; line-height: 1.55; color: hsl(20 10% 30%); max-width: 640px; margin: 0 0 8px; }
  .lede.small { font-size: 13px; color: hsl(20 10% 45%); }
  .vs-tldr { padding: 24px 0; }
  .vs-tldr h2 { font-size: 20px; margin: 0 0 12px; }
  .tldr-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .tldr-list li { padding: 12px 16px; background: hsl(42 30% 96%); border: 1px solid hsl(42 20% 82%); border-radius: 8px; font-size: 14.5px; line-height: 1.55; }
  .tldr-list strong { color: hsl(20 40% 25%); }
  .vs-matrix { padding: 40px 0 16px; }
  .vs-matrix h2 { font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; font-size: 28px; margin: 0 0 20px; }
  .cap-table { width: 100%; border-collapse: collapse; font-size: 13px; background: white; border: 1px solid hsl(42 20% 82%); border-radius: 8px; overflow: hidden; }
  .cap-table th { text-align: left; padding: 10px 12px; background: hsl(42 30% 90%); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; color: hsl(20 20% 25%); border-bottom: 1px solid hsl(42 20% 82%); }
  .cap-table td { padding: 10px 12px; vertical-align: top; border-bottom: 1px solid hsl(42 20% 90%); line-height: 1.5; }
  .cap-table tr:last-child td { border-bottom: none; }
  .cap-table .row-name { font-weight: 600; color: hsl(20 25% 20%); width: 22%; }
  .cap-table .row-note { color: hsl(20 10% 40%); font-size: 12px; width: 38%; }
  .detail-expand { margin-top: 16px; }
  .detail-expand summary { cursor: pointer; font-size: 14px; color: hsl(20 30% 30%); padding: 8px 0; font-weight: 500; }
  .detail-expand[open] > summary { margin-bottom: 12px; }
  .vs-faq { padding: 48px 0 16px; }
  .vs-faq h2 { font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; font-size: 28px; margin: 0 0 16px; }
  .faq-item { border-bottom: 1px solid hsl(42 20% 82%); padding: 12px 0; }
  .faq-item summary { cursor: pointer; font-size: 15px; font-weight: 500; color: hsl(20 30% 25%); list-style: none; padding: 4px 0; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::before { content: '+ '; color: hsl(20 40% 40%); font-weight: 600; margin-right: 6px; }
  .faq-item[open] summary::before { content: '– '; }
  .faq-item p { margin: 8px 0 0; padding: 0 0 6px 16px; font-size: 14px; line-height: 1.6; color: hsl(20 10% 30%); }
  .vs-cta { padding: 40px 0 80px; text-align: center; }
  .vs-cta h2 { font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; font-size: 28px; margin: 0 0 8px; }
  .vs-cta p { color: hsl(20 10% 40%); font-size: 14px; margin: 0 0 20px; }
  .ctas { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
  .btn, .btn-secondary { display: inline-block; padding: 10px 18px; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: 500; }
  .btn { background: hsl(20 45% 20%); color: white; }
  .btn-secondary { background: transparent; color: hsl(20 30% 25%); border: 1px solid hsl(42 20% 70%); }
</style>
