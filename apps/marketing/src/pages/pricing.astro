---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

// Pricing source of truth. Mirror any change here into:
//   - packages/gateway-mcp/src/config.ts  (FEATURE_GATES + AGENT_ENFORCEMENT_LIMITS)
//   - apps/marketing/src/pages/api/checkout.ts  (Stripe price ID map)
//   - apps/marketing/src/pages/api/stripe-webhook.ts  (plan → license row)
//   - apps/compliance-cockpit/src/hooks/useLicenseTier.ts  (tier ranking)
//
// Open-core strategy: OSS core stays free forever; SSO / SAML / crypto
// audit / long retention / EE self-host binary are the paid gates.
// Self-hosting is allowed at every tier — paid features simply refuse
// to activate without a license key.
const tiers = [
  {
    id: 'free',
    name: 'Free',
    price: '$0',
    period: 'forever',
    blurb: 'For solo devs kicking the tires. Self-host, tap the core detectors, ship your first agent under guard today.',
    cta:   { label: 'Download AEGIS', href: '/download' },
    featured: false,
    quotas: [
      '3 agents',
      '1,000 tool-call checks / month',
      '7-day trace retention',
      '1 seat',
    ],
    features: [
      'Deterministic policy + behavioural anomaly detection',
      'Basic policy pack (BFSI + Healthcare community rules)',
      'Local SQLite storage',
      'Community Slack',
    ],
  },
  {
    id: 'pro',
    name: 'Pro',
    price: '$29',
    period: '/month',
    annualPrice: '$290 / yr (save 17%)',
    blurb: 'For startups gating production agents. Unlocks the LLM-judge + DSL editor + OIDC.',
    cta:   { label: 'Upgrade to Pro', href: '#', plan: 'pro' },
    featured: true,
    quotas: [
      '20 agents',
      '100,000 checks / month',
      '30-day trace retention',
      '5 seats',
    ],
    features: [
      'Everything in Free, plus:',
      'Full detector chain (adds calibrated LLM-judge)',
      'Policy DSL editor + AI-generated bundles',
      'Multi-agent collusion detector',
      'OIDC SSO',
      'Email support, 1 business-day SLA',
    ],
  },
  {
    id: 'team',
    name: 'Team',
    price: '$99',
    period: '/month',
    annualPrice: '$990 / yr (save 17%)',
    blurb: 'For mid-market teams bringing AEGIS into compliance reviews. Cryptographic audit, SAML, unlimited agents.',
    cta:   { label: 'Upgrade to Team', href: '#', plan: 'team' },
    featured: false,
    quotas: [
      'Unlimited agents',
      '1,000,000 checks / month',
      '90-day trace retention',
      '10 seats · $15 / extra seat',
    ],
    features: [
      'Everything in Pro, plus:',
      'Cryptographic audit (Merkle log) + witness cosignature',
      'SAML 2.0 + SCIM 2.0 provisioning',
      'PI corpus + policy coverage report',
      'Policy effectiveness scoring',
      'Priority Slack support',
    ],
  },
  {
    id: 'business',
    name: 'Business',
    price: '$299',
    period: '/month',
    annualPrice: '$2,990 / yr (save 17%)',
    blurb: 'For companies self-hosting AEGIS in production. Enterprise Edition binary license included.',
    cta:   { label: 'Upgrade to Business', href: '#', plan: 'business' },
    featured: false,
    quotas: [
      'Unlimited everything',
      '365-day trace retention',
      '25 seats · $15 / extra seat',
      'Self-host EE binary license included',
    ],
    features: [
      'Everything in Team, plus:',
      'Custom detectors + on-call engineering (4h business)',
      'License-gated EE features unlock in your on-prem binary',
      'Managed self-host: we run your Helm chart under SLA',
      'Advanced RBAC + delegation observability',
      'Quarterly security review',
    ],
  },
  {
    id: 'enterprise',
    name: 'Enterprise',
    price: 'Custom',
    period: '',
    blurb: 'For regulated industries — BYOC, on-prem airgap, SOC 2 evidence, 24/7 SLA.',
    cta:   { label: 'Contact sales', href: 'mailto:aojieyuan04@gmail.com' },
    featured: false,
    quotas: [
      'Unlimited everything',
      'Custom retention (forever available)',
      'Unlimited seats',
      'BYOC / on-prem / air-gap deploy',
    ],
    features: [
      'Everything in Business, plus:',
      'SOC 2 Type II report',
      '99.9% SLA, 24/7 PagerDuty',
      'MSA + DPA + BAA available',
      'Dedicated Slack + named CSE',
      'Data residency / usage-metering controls',
    ],
  },
];

// Product + AggregateOffer — this is what AI answer engines pull when
// a user asks "how much does AEGIS cost" / "AI agent safety pricing".
// Rich results in Google's pricing SERP module also read from here.
// AggregateOffer > individual Offer blocks because it lets crawlers
// state a lowPrice/highPrice range without picking a single tier.
const siteUrl = 'https://aegistraces.com';
const priceOffers = tiers
  .filter(t => t.price.startsWith('$'))
  .map(t => ({
    '@type':        'Offer',
    name:           t.name,
    price:          t.price.replace(/[^0-9.]/g, ''),
    priceCurrency:  'USD',
    availability:   'https://schema.org/InStock',
    url:            t.cta.href,
    description:    t.blurb,
    ...(t.period === '/month' && {
      priceSpecification: {
        '@type':               'UnitPriceSpecification',
        price:                 t.price.replace(/[^0-9.]/g, ''),
        priceCurrency:         'USD',
        billingIncrement:      1,
        unitCode:              'MON',
        referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitCode: 'MON' },
      },
    }),
  }));

const productLd = {
  '@context': 'https://schema.org',
  '@type':    'Product',
  '@id':      `${siteUrl}/pricing#product`,
  name:       'AEGIS',
  description: 'AEGIS runtime safety platform for AI agents. Free MIT engine, paid cloud control plane with SSO, longer audit retention, and compliance features.',
  brand: { '@id': `${siteUrl}/#organization` },
  category: 'SecurityApplication',
  image:   `${siteUrl}/og-image.png`,
  offers: {
    '@type':       'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice:      '0',
    highPrice:     '99',
    offerCount:    priceOffers.length + 1, // paid tiers + Enterprise (custom)
    offers:        priceOffers,
  },
};

// FAQPage — the pricing questions AI answer engines consistently
// extract. Kept to 5 items because that's the sweet spot for AI
// Overview extraction (7+ tends to get truncated).
const faqLd = {
  '@context': 'https://schema.org',
  '@type':    'FAQPage',
  '@id':      `${siteUrl}/pricing#faq`,
  mainEntity: [
    {
      '@type': 'Question',
      name:    'Is AEGIS free to use?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:    'Yes. The core detector chain, agent registry, and trace store are open-source (MIT) and free forever — you can self-host with no license key. Open-core paid tiers ($49/mo Pro adds LLM-judge + DSL editor + OIDC SSO; $199/mo Team adds cryptographic audit + SAML; $599/mo Business adds an EE binary license for your on-prem install + custom detectors; Enterprise adds SOC 2 + 24/7 SLA + air-gap). Self-hosting is allowed at every tier; paid features simply refuse to activate without a valid license key.',
      },
    },
    {
      '@type': 'Question',
      name:    'What is a "check" and how do I count them?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:    'A check is one call to /api/v1/check — the gateway endpoint the SDK hits before every tool invocation to decide allow / deny / require human approval. One user prompt to an agent typically produces 3–10 checks depending on how many tools the agent chains. Free (1k/mo) covers a solo developer; Pro (100k/mo) covers small production deployments; Team + Business (1M/mo) covers most mid-market usage.',
      },
    },
    {
      '@type': 'Question',
      name:    'Can I self-host AEGIS instead of using your cloud?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:    'Yes. Self-hosting is a first-class deployment mode — the same gateway container runs on your infrastructure with your database. All tiers can self-host; Enterprise adds BYOC (bring-your-own-cloud) and on-prem airgap deploys with a signed installer for regulated environments.',
      },
    },
    {
      '@type': 'Question',
      name:    'What compliance frameworks does AEGIS support?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:    'SOC 2 Type II (Enterprise tier ships the report), PCI-DSS v4.0 Req 8 + 10, HIPAA §164.312 (5 implementation specs mapped), and GDPR Article 22 (automated decision-making). The cryptographic audit log is RFC 6962 (Certificate Transparency) with Sigstore-witness cosignature, so an auditor can verify tamper-evidence without trusting AEGIS.',
      },
    },
    {
      '@type': 'Question',
      name:    'How does AEGIS pricing compare to Lakera Guard, Robust Intelligence, or Guardrails AI?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:    'Free forever tier — Lakera and Robust Intelligence do not offer one; Guardrails AI is open-source but does not include a gateway or audit log. Paid tiers start at $29/mo Pro — one-fifth of Langfuse Team ($499) and one-tenth of Lakera Guard (typically $2k+/mo). AEGIS is MIT-open-source and does not need SaaS margins; you pay for support, compliance artifacts, and the EE binary license — not the code.',
      },
    },
  ],
};
---

<Layout
  title="Pricing — AEGIS"
  description="AEGIS pricing — Free (1k requests/mo, self-host), Pro ($29/mo, 100k requests, LLM-judge + OIDC), Team ($99/mo, 1M requests, SAML + crypto audit), Business ($299/mo, EE self-host license), Enterprise (BYOC, SOC 2, 24/7)."
>
  <Header current="pricing" />

  <main>
    <section class="head">
      <div class="container container-narrow">
        <p class="eyebrow">Pricing</p>
        <h1>Pay for operations, not the code.</h1>
        <p class="lede">
          AEGIS is MIT-licensed. The same gateway, cockpit, and detectors
          power self-host and hosted. You pay only when you want us to
          run Postgres, sign the SOC&nbsp;2 report, and answer the pager.
        </p>
      </div>
    </section>

    <section class="paths">
      <div class="container">
        <div class="path-grid">
          <article class="path">
            <header>
              <span class="path-tag">Path 1</span>
              <h2>Self-host</h2>
              <div class="path-price"><span class="amount">$0</span><span class="period">MIT, forever</span></div>
            </header>
            <p class="path-blurb">
              Run AEGIS on your own infra — Docker, Helm, or a single
              binary. Same code as our hosted SaaS, no feature lock.
            </p>
            <ul class="path-points">
              <li>All detectors, packs, and SDKs</li>
              <li>Full audit / compliance bundles</li>
              <li>Community Slack support</li>
              <li>You operate Postgres, TLS, backups</li>
            </ul>
            <div class="path-cta">
              <a class="btn-secondary" href="https://github.com/Justin0504/Aegis">Download from GitHub</a>
              <code>curl -fsSL aegistraces.com/install.sh | bash</code>
            </div>
          </article>

          <article class="path featured">
            <header>
              <span class="path-tag">Path 2</span>
              <h2>Hosted SaaS</h2>
              <div class="path-price"><span class="amount">$0–Custom</span><span class="period">we run it</span></div>
            </header>
            <p class="path-blurb">
              We run the gateway in our cloud. You point your agents at
              it and stop thinking about uptime, backups, or upgrades.
            </p>
            <ul class="path-points">
              <li>Free tier — 1k checks / mo, no card</li>
              <li>Managed Postgres, hourly PITR</li>
              <li>SLA-backed support on Pro+</li>
              <li>SOC&nbsp;2 evidence pack on Enterprise</li>
            </ul>
            <div class="path-cta">
              <a class="btn" href="/download">Download AEGIS</a>
              <span class="path-fine">Then pick a tier below when you outgrow Free.</span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="tiers">
      <div class="container container-narrow tier-eyebrow">
        <p class="eyebrow">Hosted tiers</p>
        <p class="tier-sub">All four tiers run the same MIT-licensed code. You're paying for operations, support, and compliance artifacts — not features the OSS doesn't have.</p>
      </div>
      <div class="container">
        <div class="tier-grid">
          {tiers.map(t => (
            <article class={`tier ${t.featured ? 'featured' : ''}`}>
              {t.featured && <div class="badge">Most popular</div>}
              <header>
                <h2>{t.name}</h2>
                <div class="price">
                  <span class="amount">{t.price}</span>
                  <span class="period">{t.period}</span>
                </div>
                {t.annualPrice && <p class="annual">{t.annualPrice}</p>}
                <p class="blurb">{t.blurb}</p>
              </header>
              <ul class="quotas">
                {t.quotas.map(q => <li class="quota">{q}</li>)}
              </ul>
              <ul class="features">
                {t.features.map(f => <li>{f}</li>)}
              </ul>
              {(t.cta as any).plan
                ? <button class={`checkout-btn ${t.featured ? 'btn' : 'btn-secondary'}`}
                          data-plan={(t.cta as any).plan}>{t.cta.label}</button>
                : <a class={t.featured ? 'btn' : 'btn-secondary'} href={t.cta.href}>{t.cta.label}</a>
              }
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="faq">
      <div class="container container-narrow">
        <h2>Pricing FAQ</h2>

        <details>
          <summary>What counts as a "check"?</summary>
          <p>One POST to <code>/api/v1/check</code> or one LLM call
            routed through the egress proxy. Tool-call traces ingested
            for audit but NOT subject to a policy decision (e.g.
            historical replay) do not count.</p>
        </details>

        <details>
          <summary>What happens at the cap?</summary>
          <p>On Free, requests over 1,000/month return a 429 with a
            soft window — your agent retries the next month at zero
            disruption. On paid plans, overages are billed per
            10,000-check block ($1 on Pro, $0.50 on Team) — no
            request is ever dropped on a paid plan.</p>
        </details>

        <details>
          <summary>Can I self-host instead?</summary>
          <p>Yes — AEGIS is MIT-licensed.
            <code>docker compose up -d</code> from the
            <a href="https://github.com/Justin0504/Aegis" rel="noopener">GitHub repo</a>
            gives you the same gateway. Hosted SaaS is for teams who
            don't want to operate it.</p>
        </details>

        <details>
          <summary>Do I need a credit card to start?</summary>
          <p>No. Free tier requires only email verification. Upgrading
            to Pro is the first time we ask for a payment method.</p>
        </details>

        <details>
          <summary>Is there a startup / academic discount?</summary>
          <p>Yes — 50% off Pro and Team for the first 12 months for
            YC-backed companies, USC / MIT / Berkeley labs, and any
            org with &lt; 10 employees + &lt; $1M ARR. Email
            <a href="mailto:aojieyuan04@gmail.com">aojieyuan04@gmail.com</a>.</p>
        </details>

        <details>
          <summary>How does Enterprise differ technically?</summary>
          <p>Same codebase — but you get a deployment we operate inside
            your cloud (BYOC) or on-prem in an airgapped network,
            plus dedicated engineering time. We sign DPA, BAA, and any
            customer-specific MSA your legal team requires.</p>
        </details>
      </div>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(productLd)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>

  <script is:inline>
    // Checkout buttons — POST to /api/checkout and follow the returned
    // Stripe Checkout URL. If the user isn't signed in the middleware
    // has already sent them to /login?next=/pricing, so at this point
    // we can assume a session exists. On 401 (session expired between
    // page load and click) we bounce them back to /login.
    document.querySelectorAll('button.checkout-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const plan = btn.getAttribute('data-plan');
        const original = btn.textContent;
        btn.setAttribute('disabled', 'true');
        btn.textContent = 'Opening checkout…';
        try {
          const res = await fetch('/api/checkout', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ plan }),
          });
          if (res.status === 401) {
            location.href = `/login?next=${encodeURIComponent(location.pathname)}`;
            return;
          }
          const body = await res.json();
          if (!res.ok) throw new Error(body.error || `HTTP ${res.status}`);
          if (body.url) location.href = body.url;
          else throw new Error('no checkout url returned');
        } catch (err) {
          alert(`Checkout failed: ${err.message}`);
          btn.removeAttribute('disabled');
          btn.textContent = original;
        }
      });
    });
  </script>

  <Footer />

  <style>
    .head { padding: 5rem 0 2rem; }
    .eyebrow {
      font-size: 0.82rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      font-weight: 500;
      margin: 0 0 0.5rem;
    }
    .lede {
      max-width: 60ch;
      color: var(--muted);
      font-size: 1.1rem;
      margin: 1rem 0 0;
    }

    /* Two-path strip */
    .paths { padding: 1rem 0 2rem; }
    .path-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.2rem;
    }
    .path {
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: 14px;
      padding: 1.8rem 1.6rem;
    }
    .path.featured {
      border: 1px solid var(--accent);
      background: var(--surface-2);
    }
    .path header { display: flex; flex-direction: column; gap: 0.3rem; }
    .path-tag {
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .path h2 {
      font-family: var(--font-serif);
      font-size: 1.8rem;
      margin: 0;
    }
    .path-price {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      margin-top: 0.2rem;
    }
    .path-price .amount { font-size: 1.7rem; font-weight: 600; }
    .path-price .period { color: var(--muted); font-size: 0.9rem; }
    .path-blurb { color: var(--muted); margin: 0; font-size: 0.97rem; line-height: 1.55; }
    .path-points {
      list-style: none;
      padding: 0.6rem 0;
      margin: 0;
      border-top: 1px solid var(--hairline);
      border-bottom: 1px solid var(--hairline);
    }
    .path-points li {
      font-size: 0.92rem;
      padding: 0.22rem 0;
      color: var(--text);
    }
    .path-points li::before {
      content: "✓ ";
      color: var(--accent-positive);
      font-weight: 700;
      margin-right: 0.2rem;
    }
    .path-cta {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-top: auto;
    }
    .path-cta code {
      background: var(--bg);
      border: 1px solid var(--hairline);
      border-radius: 6px;
      padding: 0.5rem 0.7rem;
      font-size: 0.82rem;
      color: var(--muted);
      overflow-x: auto;
    }
    .path-fine { color: var(--muted); font-size: 0.85rem; text-align: center; }
    @media (max-width: 760px) {
      .path-grid { grid-template-columns: 1fr; }
    }

    .tier-eyebrow { margin-bottom: 1.2rem; }
    .tier-sub { color: var(--muted); margin: 0.4rem 0 0; font-size: 0.95rem; }

    .tiers { padding: 1rem 0 4rem; }
    .tier-grid {
      display: grid;
      /* 5 tiers → 5 columns on wide desktops. Breakpoints below
         collapse to 3 → 2 → 1 as viewport shrinks. */
      grid-template-columns: repeat(5, 1fr);
      gap: 1rem;
    }
    .tier {
      position: relative;
      display: flex;
      flex-direction: column;
      background: var(--surface);
      border: 1px solid var(--hairline);
      border-radius: 12px;
      padding: 1.6rem 1.4rem 1.4rem;
    }
    .tier.featured {
      border: 1px solid var(--accent);
      background: var(--surface-2);
      transform: scale(1.02);
    }
    .badge {
      position: absolute;
      top: -0.7rem;
      left: 50%;
      transform: translateX(-50%);
      background: var(--accent);
      color: var(--bg);
      font-size: 0.74rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 0.3rem 0.6rem;
      border-radius: 99px;
      white-space: nowrap;
    }
    .tier header h2 {
      font-family: var(--font-serif);
      font-size: 1.6rem;
      margin: 0;
    }
    .price { display: flex; align-items: baseline; gap: 0.3rem; margin: 0.5rem 0 0.2rem; }
    .price .amount { font-size: 2rem; font-weight: 600; }
    .price .period { color: var(--muted); font-size: 0.9rem; }
    .annual { color: var(--muted); font-size: 0.82rem; margin: 0; }
    .blurb { color: var(--muted); font-size: 0.92rem; margin: 0.6rem 0 1rem; min-height: 4em; }
    .quotas {
      list-style: none;
      padding: 0.9rem 0;
      margin: 0 0 1rem;
      border-top: 1px solid var(--hairline);
      border-bottom: 1px solid var(--hairline);
    }
    .quotas .quota {
      font-size: 0.9rem;
      padding: 0.18rem 0;
      color: var(--text);
    }
    .features {
      list-style: none;
      padding: 0;
      margin: 0 0 1.2rem;
      flex: 1;
    }
    .features li {
      font-size: 0.9rem;
      padding: 0.22rem 0;
      color: var(--muted);
    }
    .features li::before {
      content: "✓ ";
      color: var(--accent-positive);
      font-weight: 700;
      margin-right: 0.1rem;
    }
    .tier .btn, .tier .btn-secondary {
      justify-content: center;
      width: 100%;
    }

    /* Below ~1240px, 5 cols become too narrow — regroup 3+2 (last
       two tiers wrap to a shorter row); below 980 fall to 2×3. */
    @media (max-width: 1240px) {
      .tier-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @media (max-width: 980px) {
      .tier-grid { grid-template-columns: repeat(2, 1fr); }
      .tier.featured { transform: none; }
    }
    @media (max-width: 560px) {
      .tier-grid { grid-template-columns: 1fr; }
    }

    /* FAQ */
    .faq { padding: 4rem 0; border-top: 1px solid var(--hairline); }
    .faq h2 { margin-bottom: 1.5rem; }
    .faq details {
      border-bottom: 1px solid var(--hairline);
      padding: 1rem 0;
    }
    .faq summary {
      cursor: pointer;
      font-weight: 500;
      font-size: 1.04rem;
      padding: 0.2rem 0;
    }
    .faq details[open] summary { margin-bottom: 0.6rem; }
    .faq details p { color: var(--muted); margin: 0; line-height: 1.6; }
  </style>
</Layout>
