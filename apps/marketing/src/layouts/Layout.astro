---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalPath?: string;
}
const {
  title = 'AEGIS — runtime safety for AI agents',
  description = 'AEGIS is the open-source runtime firewall for AI agents. Stop hallucinated tool calls before they hit production — zero code change, SOC 2 framework, multi-tenant, MIT licensed.',
  ogImage = '/og-image.png',
  canonicalPath,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://aegistraces.com';
const canonical = new URL(canonicalPath ?? Astro.url.pathname, siteUrl).toString();
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// Global Organization schema — emitted on every page so any crawler
// landing anywhere on the site can resolve who owns it, where the
// source lives, and how to contact the maintainer. `sameAs` links
// out to GitHub / arXiv work — crawlers use these to cross-verify
// authority (an org with a real repo + published prior art ranks
// differently than an org with only a landing page).
const organizationLd = {
  '@context': 'https://schema.org',
  '@type':    'Organization',
  '@id':      `${siteUrl}/#organization`,
  name:       'AEGIS',
  alternateName: 'AgentGuard',
  url:        siteUrl,
  logo: {
    '@type': 'ImageObject',
    url:     `${siteUrl}/favicon.svg`,
  },
  description: 'Open-source runtime safety and cryptographic audit platform for AI agents.',
  foundingDate: '2025',
  founder: {
    '@type': 'Person',
    name:    'Aojie Yuan',
    affiliation: {
      '@type': 'CollegeOrUniversity',
      name:    'University of Southern California',
    },
  },
  contactPoint: [
    {
      '@type':       'ContactPoint',
      email:         'partners@aegistraces.com',
      contactType:   'sales',
      areaServed:    'Worldwide',
      availableLanguage: ['English'],
    },
    {
      '@type':       'ContactPoint',
      email:         'security@aegistraces.com',
      contactType:   'security',
      areaServed:    'Worldwide',
    },
  ],
  sameAs: [
    'https://github.com/Justin0504/Aegis',
    'https://arxiv.org/abs/2606.09692',
    'https://arxiv.org/abs/2606.07119',
  ],
};

// Global WebSite schema — declares the site as a searchable entity
// and (critically) tells Google's Sitelinks Searchbox where the
// in-site search URL lives. Even when we don't ship a real search UI,
// declaring the /blog?q= URL template lets AI answer engines route
// users straight to filtered content rather than the landing page.
const websiteLd = {
  '@context': 'https://schema.org',
  '@type':    'WebSite',
  '@id':      `${siteUrl}/#website`,
  url:        siteUrl,
  name:       'AEGIS',
  publisher:  { '@id': `${siteUrl}/#organization` },
  inLanguage: 'en-US',
  potentialAction: {
    '@type':       'SearchAction',
    target:        `${siteUrl}/blog?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#eae3d2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1816" media="(prefers-color-scheme: dark)" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="AEGIS" />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(organizationLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)}></script>

    <title>{title}</title>
  </head>
  <body>
    <!--
      Scroll progress bar — thin gradient bar at the top of the
      viewport that fills as the reader scrolls. Hitachi Vantara uses
      the same pattern (red→purple under their header). Ours goes
      sand → sage → deep-sand so it reads as an AEGIS palette indicator
      rather than a decoration. JS-driven because Astro's lightningcss
      build strips `animation-timeline: scroll()`.
    -->
    <div id="aegis-scroll-progress" aria-hidden="true"></div>
    <script is:inline>
      (() => {
        const bar = document.getElementById('aegis-scroll-progress');
        if (!bar) return;
        let raf = 0;
        const update = () => {
          const doc = document.documentElement;
          const max = doc.scrollHeight - doc.clientHeight;
          const pct = max > 0 ? doc.scrollTop / max : 0;
          bar.style.transform = 'scaleX(' + pct.toFixed(4) + ')';
          raf = 0;
        };
        const onScroll = () => {
          if (raf) return;
          raf = requestAnimationFrame(update);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        update();
      })();
    </script>

    <slot />

    <style is:global>
      /* Scroll progress bar — fixed above every sticky header. */
      #aegis-scroll-progress {
        position: fixed;
        top: 0; left: 0; right: 0;
        height: 3px;
        z-index: 100;
        background: linear-gradient(
          90deg,
          hsl( 45 35% 78%)  0%,
          hsl(150 26% 56%) 45%,
          hsl( 25 40% 55%) 100%
        );
        transform-origin: left center;
        transform: scaleX(0);
        will-change: transform;
        pointer-events: none;
        box-shadow: 0 1px 4px rgba(10, 10, 10, 0.10);
      }

      :root {
        --bg: #eae3d2;
        --surface: #f2edd8;
        --surface-2: #ece6cf;
        --text: #0a0a0a;
        --muted: #5c5a50;
        --hairline: rgba(10, 10, 10, 0.10);
        --hairline-strong: rgba(10, 10, 10, 0.22);
        --accent: #0a0a0a;
        --accent-positive: #2d6a4f;
        --accent-warn: #b07d2e;
        --accent-error: #9c2a2a;
        --link: #0a0a0a;
        --font-sans: 'Inter', system-ui, -apple-system, "Segoe UI", sans-serif;
        --font-serif: 'Instrument Serif', "Iowan Old Style", Georgia, serif;
        --font-mono: 'JetBrains Mono', ui-monospace, "SF Mono", monospace;
        color-scheme: light;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #1a1816;
          --surface: #242220;
          --surface-2: #2b2926;
          --text: #eae3d2;
          --muted: #9a968b;
          --hairline: rgba(234, 227, 210, 0.10);
          --hairline-strong: rgba(234, 227, 210, 0.22);
          --accent: #eae3d2;
          --link: #eae3d2;
          color-scheme: dark;
        }
      }
      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 16px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--link); text-decoration: underline; text-underline-offset: 3px; }
      a:hover { text-decoration: none; }
      code, pre {
        font-family: var(--font-mono);
        font-size: 0.92em;
      }
      pre {
        background: var(--surface);
        padding: 1rem 1.1rem;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 0.86rem;
        line-height: 1.55;
        border: 1px solid var(--hairline);
      }
      h1, h2, h3 { font-family: var(--font-serif); font-weight: 400; letter-spacing: -0.01em; }
      h1 { font-size: clamp(2.6rem, 6vw, 4.2rem); line-height: 1.05; margin: 0.5rem 0 1rem; }
      h2 { font-size: clamp(1.9rem, 3.4vw, 2.6rem); line-height: 1.15; margin: 0 0 1rem; }
      h3 { font-size: 1.35rem; line-height: 1.3; margin: 0 0 0.6rem; }
      em { font-style: italic; }

      .container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }
      .container-narrow {
        max-width: 760px;
      }

      /* Buttons / CTAs */
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.75rem 1.2rem;
        background: var(--accent);
        color: var(--bg);
        border: 1px solid var(--accent);
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.96rem;
        transition: background 0.15s, color 0.15s, transform 0.05s;
      }
      .btn:hover { background: transparent; color: var(--accent); }
      .btn:active { transform: translateY(1px); }
      .btn-secondary {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.75rem 1.2rem;
        background: transparent;
        color: var(--accent);
        border: 1px solid var(--hairline-strong);
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.96rem;
      }
      .btn-secondary:hover { border-color: var(--accent); }

      hr { border: 0; border-top: 1px solid var(--hairline); margin: 3rem 0; }
    </style>
  </body>
</html>
