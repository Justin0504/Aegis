---
/**
 * Testimonials.astro — Railway-style horizontal scrolling marquee.
 *
 * Pure CSS marquee — duplicates the track and translates 0 → -50%
 * for a seamless infinite loop. Never pauses, even on hover.
 *
 * Testimonial data lives in src/data/testimonials.ts so the login
 * page can render the same voices in a different layout without
 * copy-pasting the array.
 */
import { TESTIMONIALS } from '../data/testimonials';
---

<section class="tm">
  <div class="container">
    <p class="tm-eyebrow">From the field</p>
    <h2 class="tm-h2">What builders and researchers say.</h2>
  </div>

  <div class="tm-marquee" aria-label="Testimonials carousel">
    <div class="tm-track" role="list">
      {[...TESTIMONIALS, ...TESTIMONIALS].map((t, i) => (
        <article class="tm-card" role="listitem" aria-hidden={i >= TESTIMONIALS.length}>
          <header class="tm-head">
            <img class="tm-photo" src={t.photo} alt={t.name} loading="lazy" width="44" height="44" />
            <div class="tm-who">
              <strong>{t.name}</strong>
              <span class="tm-handle">{t.handle}</span>
            </div>
          </header>
          <p class="tm-title">{t.title}</p>
          <blockquote class="tm-quote" set:html={t.quote.replaceAll('@AEGIS', '<span class="tm-mention">@AEGIS</span>')} />
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .tm {
    padding: 4.5rem 0 4rem;
    border-top: 1px solid var(--hairline);
    overflow: hidden;
  }
  .tm-eyebrow {
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
    margin: 0 0 0.5rem;
  }
  .tm-h2 {
    font-family: var(--font-serif);
    font-size: 2rem;
    margin: 0 0 2.2rem;
    letter-spacing: -0.01em;
  }

  /* ── Marquee ───────────────────────────────────────── */
  .tm-marquee {
    --gap: 1.2rem;
    --card-w: 360px;
    --speed: 80s;

    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
    mask-image: linear-gradient(
      90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
  }
  .tm-track {
    display: flex;
    gap: var(--gap);
    width: max-content;
    animation: tm-scroll var(--speed) linear infinite;
  }
  @keyframes tm-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(calc(-50% - var(--gap) / 2)); }
  }
  /* Never pauses — runs at the same speed always */
  @media (prefers-reduced-motion: reduce) {
    .tm-track { animation: none; transform: none; }
  }

  /* ── Card ──────────────────────────────────────────── */
  .tm-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 14px;
    padding: 1.3rem 1.45rem 1.25rem;
    width: var(--card-w);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .tm-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .tm-photo {
    width: 44px; height: 44px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    box-shadow:
      0 1px 2px rgba(10, 10, 10, 0.10),
      inset 0 -1px 0 rgba(10, 10, 10, 0.08);
  }
  .tm-who {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
    min-width: 0;
  }
  .tm-who strong {
    font-size: 0.96rem;
    font-weight: 600;
    color: var(--text);
  }
  .tm-handle {
    font-size: 0.8rem;
    color: var(--muted);
    font-family: ui-monospace, monospace;
  }
  .tm-title {
    font-size: 0.78rem;
    color: var(--muted);
    margin: 0;
    letter-spacing: 0.005em;
  }
  .tm-quote {
    margin: 0;
    font-size: 0.96rem;
    line-height: 1.55;
    color: var(--text);
    quotes: "\201C" "\201D";
  }
  .tm-quote::before { content: open-quote; opacity: 0.5; padding-right: 0.05em; }
  .tm-quote::after  { content: close-quote; opacity: 0.5; padding-left: 0.05em; }
  .tm-mention {
    color: var(--text);
    font-weight: 600;
    background: hsl(45 26% 88%);
    padding: 0.04rem 0.3rem;
    border-radius: 3px;
    font-family: ui-monospace, monospace;
    font-size: 0.86em;
  }
</style>
